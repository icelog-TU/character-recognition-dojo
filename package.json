{
  "name": "character-recognition-dojo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:firebase": "tsc -b && vite build --base /",
    "deploy:firebase": "npm run build:firebase && npx firebase-tools deploy --only hosting",
    "lint": "oxlint",
    "assets:align": "node scripts/align-audio-timings.mjs",
    "assets:align:ai": "node scripts/align-audio-timings-ai.mjs",
    "assets:audit": "node scripts/audit-asset-formats.mjs",
    "assets:audio": "node scripts/process-audio-assets.mjs",
    "assets:images": "node scripts/optimize-images.mjs",
    "audio:review-status": "node scripts/check-audio-review-status.mjs",
    "ai:audio": "node scripts/generate-audio-drafts.mjs",
    "ai:check": "node scripts/check-ai-setup.mjs",
    "ai:sentences": "node scripts/generate-sentence-candidates.mjs",
    "curriculum:export-planner": "node scripts/export-planner-data.mjs",
    "curriculum:packet": "node scripts/create-generation-packet.mjs",
    "curriculum:recommend": "node scripts/recommend-next-lesson.mjs",
    "curriculum:request-from-review": "node scripts/create-request-from-review.mjs",
    "curriculum:audit-state": "node scripts/audit-curriculum-state.mjs",
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "validate:production": "node scripts/validate-production-assets.mjs",
    "verify": "npm run curriculum:audit-state && npm run validate:curriculum && npm run validate:production && npm run lint && npm run build",
    "preview": "vite preview",
    "tools:check": "node scripts/check-local-tools.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}

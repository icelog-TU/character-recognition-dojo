# Copy this file to .env.local on your own computer.
# Never put a real API key in this example file.

OPENAI_API_KEY=sk-your-key-here

# Text generation for curriculum sentence candidates.
OPENAI_TEXT_MODEL=gpt-5-mini

# Text-to-speech for reviewed character and sentence audio drafts.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

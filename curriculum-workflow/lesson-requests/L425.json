  "approvedSentences": [
    {
      "id": "L425-S01",
      "text": "各班排好隊，回教室。",
      "spokenText": "各班排好隊回教室",
      "displayLines": [
        "各班排好隊，",
        "回教室。"
      ],
      "focusChar": "各",
      "imageNotes": "學校集合活動結束，老師在操場向不同班級示意排隊回教室。畫面清楚呈現至少三個分開的班級隊伍，每班前方有帶領的老師，隊伍之間保留間隔。主角小女孩在其中一班，其他班以 generic 同學及老師呈現。前方可見通往教學樓的路線，學生仍在排整齊、準備返回，不是放學離校。不可只畫一班的一條長隊，也不要把不同班級混成一群。不需班牌文字或班級數字。",
      "approved": true,
      "zhuyinOverrides": {
        "6": "ㄐㄧㄠˋ"
      }
    },
    {
      "id": "L425-S02",
      "text": "請各組選出一位隊長。",
      "spokenText": "請各組選出一位隊長",
      "displayLines": [
        "請各組選出",
        "一位隊長。"
      ],
      "focusChar": "隊",
      "imageNotes": "學校戶外團體活動開始前，老師面向已分好的數個小組，請每組選一位隊長。主角小女孩所在小組與其他小組分開圍成小圈，孩子正彼此討論、有人舉手表達意見。畫面是老師提出指示、孩子開始選人，尚未宣布選舉結果。不要畫成老師直接指定一個全班隊長，也不要把全班畫成同一組。不指定小光或小月當選，不新增固定角色職務。",
      "approved": true,
      "zhuyinOverrides": {
        "8": "ㄓㄤˇ"
      }
    },
    {
      "id": "L425-S03",
      "text": "這間店有各種水果。",
      "spokenText": "這間店有各種水果",
      "displayLines": [
        "這間店有",
        "各種水果。"
      ],
      "focusChar": "各",
      "imageNotes": "水果店內，主角小女孩與主角媽媽看著分區陳列的多種水果，例如蘋果、香蕉、葡萄、橘子及西瓜。每種水果集中在自己的籃子或陳列區，外形、顏色清楚可辨，呈現種類多，不是同一種水果堆得很多。媽媽向女孩指示不同水果，店員可在櫃台後整理貨品。畫面不需價錢、品名標籤、品牌或數字。",
      "approved": true,
      "zhuyinOverrides": {
        "5": "ㄓㄨㄥˇ"
      }
    },
    {
      "id": "L425-S04",
      "text": "全班同學分組照顧花草。",
      "spokenText": "全班同學分組照顧花草",
      "displayLines": [
        "全班同學分組",
        "照顧花草。"
      ],
      "focusChar": "組",
      "imageNotes": "學校花園活動，全班分成數個小組，每組照顧不同區域的花草。主角小女孩與同組孩子照顧前景的一小區盆栽，有人適量澆水、有人收拾周圍落葉；背景另外兩組分別照顧其他花圃，老師在旁引導。要看得出多組分工與不同照顧區域，不是全班擠著澆同一盆花，也不只畫主角一人。植物保持正常、未被過量澆水，不使用危險工具。不得沿用舊句「我們班分組照顧花草」的索引資料。",

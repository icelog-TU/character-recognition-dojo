  "approvedSentences": [
    {
      "id": "L398-S01",
      "text": "這兩雙鞋，你要選哪一雙？",
      "spokenText": "這兩雙鞋你要選哪一雙",
      "displayLines": [
        "這兩雙鞋，",
        "你要選",
        "哪一雙？"
      ],
      "focusChar": "選",
      "imageNotes": "鞋店試穿區，主角媽媽陪小女孩挑鞋。女孩面前並排放著兩雙完整的鞋，共四隻：一雙紅色、一雙藍色。媽媽手掌朝向兩雙鞋，詢問女孩；女孩正在比較，尚未拿定主意。構圖聚焦這兩雙，不放其他鞋干擾數量。「你」指主角小女孩，不是固定「你」小男孩。",
      "approved": true
    },
    {
      "id": "L398-S02",
      "text": "翻開菜單，選你愛吃的菜。",
      "spokenText": "翻開菜單選你愛吃的菜",
      "displayLines": [
        "翻開菜單，",
        "選你",
        "愛吃的菜。"
      ],
      "focusChar": "翻",
      "imageNotes": "餐廳桌旁，主角媽媽邀請女孩選菜。女孩翻開一本菜單，查看雞排飯、魚料理、青菜等料理圖片，手指停在喜歡的那一道旁。是翻開書本式菜單選菜，不是上一課翻轉單張菜單看背面。菜名與價格不需可讀。「你」指主角小女孩。",
      "approved": true
    },
    {
      "id": "L398-S03",
      "text": "我選紅色的紙，蓋手印。",
      "spokenText": "我選紅色的紙蓋手印",
      "displayLines": [
        "我選",
        "紅色的紙，",
        "蓋手印。"
      ],
      "focusChar": "選",
      "imageNotes": "家中美術桌前，主角小女孩從幾張不同顏色的紙中選出紅紙，放在自己面前，正在紅紙上蓋手印。使用能與紅紙清楚對比的白色兒童用顏料；女孩手掌剛抬起，紅紙上留下清楚的白色手印。桌旁保留少量其他顏色紙張，交代選擇對象。主角媽媽在旁陪同。手印是手掌沾顏料留下，不是拿筆描繪。老師最後改的是「選紅色的紙」，不是選紅色顏料。不得沿用「白紙＋紅手印」舊畫面。",
      "approved": true
    },
    {
      "id": "L398-S04",
      "text": "先選號碼，再印在球衣上。",
      "spokenText": "先選號碼再印在球衣上",
      "displayLines": [
        "先選號碼，",
        "再印在",
        "球衣上。"
      ],
      "focusChar": "選",
      "imageNotes": "球衣印製店櫃台前，主角爸爸陪女孩選號碼。女孩指向樣本板上的「8」，旁邊另有「3」「5」可比較；工作人員順著她指的位置查看。櫃台上放著一件尚未印號碼的空白球衣。畫面停在選號碼階段，不同時呈現已印好的成品。老師已批准數字入圖例外：樣本板顯示「3、5、8」，不用品牌或其他可讀文字。",
      "approved": true
    },
    {
      "id": "L398-S05",
      "text": "這是單行道，不能往回開。",
      "spokenText": "這是單行道不能往回開",
      "displayLines": [
        "這是單行道，",
        "不能往回開。"
      ],
      "focusChar": "單",
      "imageNotes": "主角爸爸開車、媽媽坐在前座，女孩坐後座安全座椅。一家人的車沿單行道前進；路邊立著清楚的單向箭頭標誌，前方另一輛車也朝相同方向行駛。用稍高斜側視角，讓標誌方向與車輛朝向容易比較。不要畫逆向示範，不要畫成禁止進入或禁止迴轉標誌。交通標誌使用箭頭符號，不需文字。",
      "approved": true,
      "zhuyinOverrides": {
        "3": "ㄒㄧㄥˊ"
      }
    }
  ],

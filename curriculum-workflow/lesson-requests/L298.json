  "approvedSentences": [
    {
      "id": "L298-S01",
      "text": "我怕大人生氣罵人。",
      "spokenText": "我怕大人生氣罵人",
      "focusChar": "罵",
      "displayLines": [
        "我怕大人",
        "生氣罵人。"
      ],
      "imageNotes": "主角小女孩看見一位路人大人或店員生氣罵人，她站在主角媽媽旁邊覺得害怕。畫面要清楚呈現大人生氣罵人讓孩子害怕，但不要畫成主角媽媽罵孩子，不要過度兇狠；不可有文字、數字、標籤。"
    },
    {
      "id": "L298-S02",
      "text": "被人大罵，當然會嚇到。",
      "spokenText": "被人大罵當然會嚇到",
      "focusChar": "嚇",
      "displayLines": [
        "被人大罵，",
        "當然會嚇到。"
      ],
      "imageNotes": "兩個孩子或一個孩子和路人大人之間發生大聲責備情境，被罵的孩子嚇到退縮，旁邊有主角媽媽或老師溫和制止。畫面重點是被人大罵會嚇到；不要畫成成人暴怒威脅孩子，不可有文字、數字、標籤。"
    },
    {
      "id": "L298-S03",
      "text": "不要罵人，我被罵會哭。",
      "spokenText": "不要罵人我被罵會哭",
      "focusChar": "罵",
      "displayLines": [
        "不要罵人，",
        "我被罵會哭。"
      ],
      "imageNotes": "主角小女孩面對另一個孩子，表情委屈，表示不要罵人，自己被罵會哭。主角媽媽或老師在旁邊溫和調停。畫面要清楚呈現不要罵人、被罵會哭；不可畫成霸凌或激烈衝突，不可有文字、數字、標籤。"
    },
    {
      "id": "L298-S04",
      "text": "大叫罵人，好嚇人。",
      "spokenText": "大叫罵人好嚇人",
      "focusChar": "罵",
      "displayLines": [
        "大叫罵人，",
        "好嚇人。"
      ],
      "imageNotes": "一個孩子大叫罵人，主角小女孩在旁邊覺得被嚇到，老師或主角媽媽溫和制止。畫面要清楚呈現大叫罵人很嚇人；不要畫成恐怖或暴力場景，不可有文字、數字、標籤。"
    },
    {
      "id": "L298-S05",
      "text": "做錯事被罵，忍不住哭了。",
      "spokenText": "做錯事被罵忍不住哭了",
      "focusChar": "罵",
      "displayLines": [
        "做錯事被罵，",
        "忍不住哭了。"
      ],
      "imageNotes": "主角小女孩不小心做錯事，例如打翻玩具或弄亂桌面，被溫和提醒後忍不住哭了，主角媽媽在旁邊安撫。畫面要清楚呈現做錯事、被罵後忍不住哭；不要畫成嚴厲責罵或羞辱，不可有文字、數字、標籤。"
    }

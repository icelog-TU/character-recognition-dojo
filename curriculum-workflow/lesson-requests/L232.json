  "approvedSentences": [
    {
      "id": "L232-S01",
      "text": "錢只剩一半了。",
      "spokenText": "錢只剩一半了",
      "focusChar": "錢",
      "displayLines": [
        "錢只剩",
        "一半了。"
      ],
      "imageNotes": "家裡桌上有一個透明玻璃罐子，裡面裝著零錢，罐子大約只剩一半滿。主角小女孩在旁邊看著罐子，表情像是發現錢變少了。畫面重點是「零錢罐只剩半滿」，但罐子、硬幣和桌面不可有文字、數字、刻度、品牌或標籤。"
    },
    {
      "id": "L232-S02",
      "text": "這點錢夠不夠？",
      "spokenText": "這點錢夠不夠",
      "focusChar": "夠",
      "displayLines": [
        "這點錢",
        "夠不夠？"
      ],
      "imageNotes": "主角小女孩在家裡或小攤前拿著一小把硬幣問主角媽媽，媽媽低頭看著這點錢，像是在一起確認夠不夠。畫面要清楚呈現「錢很少，正在問夠不夠」。不可有價目表、文字、數字、招牌或標籤。"
    },
    {
      "id": "L232-S03",
      "text": "舊鞋還能穿。",
      "spokenText": "舊鞋還能穿",
      "focusChar": "舊",
      "displayLines": [
        "舊鞋",
        "還能穿。"
      ],
      "imageNotes": "主角小女孩坐在家門口或房間裡，看著一雙有點舊但仍完整乾淨的鞋，準備繼續穿上。主角媽媽可在旁邊點頭。畫面重點是「鞋子舊了但還能穿」。不可有文字、數字、品牌或標籤。"
    },
    {
      "id": "L232-S04",
      "text": "水池裡只剩一點水。",
      "spokenText": "水池裡只剩一點水",
      "focusChar": "剩",
      "displayLines": [
        "水池裡",
        "只剩一點水。"
      ],
      "imageNotes": "戶外小水池或學校水池裡的水很少，只剩底部一點水，池底清楚可見。主角小女孩站在池邊看著水池。畫面要清楚呈現「水池裡只剩一點水」，但不要做成危險場景。不可有文字、數字、標籤或告示牌。"
    },
    {
      "id": "L232-S05",
      "text": "我把錢包放進新書包。",
      "spokenText": "我把錢包放進新書包",
      "focusChar": "錢",
      "displayLines": [
        "我把錢包",
        "放進新書包。"
      ],
      "imageNotes": "主角小女孩在家裡或上學前，把一個錢包放進新的書包裡。主角媽媽可在旁邊看著，確認她把東西收好。畫面重點是「錢包被放進新書包」。錢包和書包不可有文字、數字、品牌、姓名牌或標籤。"
    }
  ],

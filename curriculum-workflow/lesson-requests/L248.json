  "approvedSentences": [
    {
      "id": "L248-S01",
      "text": "爸爸和我玩跳棋。",
      "spokenText": "爸爸和我玩跳棋",
      "focusChar": "跳",
      "displayLines": [
        "爸爸和我",
        "玩跳棋。"
      ],
      "imageNotes": "主角爸爸和主角小女孩在家裡桌邊玩跳棋，桌上是沒有文字和數字的跳棋棋盤與棋子。畫面重點是親子一起玩跳棋，不要讓棋盤出現任何文字、數字、品牌或標籤。人物身份要明確：主角爸爸、主角小女孩。"
    },
    {
      "id": "L248-S02",
      "text": "跑步後，心跳得很快。",
      "spokenText": "跑步後心跳得很快",
      "focusChar": "跳",
      "displayLines": [
        "跑步後，",
        "心跳得很快。"
      ],
      "imageNotes": "主角小女孩剛跑步後停下來，一手放在胸口感覺心跳很快，表情是運動後喘一點但安全健康。可在學校操場、空地或公園場景。人物身份要明確：主角小女孩。不可有文字、數字、跑道號碼或標籤。"
    },
    {
      "id": "L248-S03",
      "text": "錯了又錯，他急得跳腳。",
      "spokenText": "錯了又錯他急得跳腳",
      "focusChar": "跳",
      "displayLines": [
        "錯了又錯，",
        "他急得跳腳。"
      ],
      "imageNotes": "固定「他」男孩在做拼圖、積木或簡單手作時一直做錯，急得跳腳。畫面要表現又急又氣、連續受挫後跳腳，但不可畫成危險、暴力或受傷。人物身份要明確：固定「他」男孩。不可有文字、數字或標籤。"
    },
    {
      "id": "L248-S04",
      "text": "我光著腳，一步一步走。",
      "spokenText": "我光著腳一步一步走",
      "focusChar": "步",
      "displayLines": [
        "我光著腳，",
        "一步一步走。"
      ],
      "imageNotes": "海邊場景，主角小女孩光著腳在沙灘或淺淺濕沙上一步一步慢慢走，鞋子可放在旁邊安全位置。畫面重點是光著腳一步一步走在海邊，不要靠近危險海浪，不要有文字、數字、招牌或標籤。人物身份要明確：主角小女孩。"
    },
    {
      "id": "L248-S05",
      "text": "媽媽急著出門，我去幫忙。",
      "spokenText": "媽媽急著出門我去幫忙",
      "focusChar": "幫",
      "displayLines": [
        "媽媽急著",
        "出門，",
        "我去幫忙。"
      ],
      "imageNotes": "家門口場景，主角媽媽急著出門，主角小女孩幫忙拿包、拿鞋或把小物品遞給媽媽。畫面要表現「急著出門」和「我去幫忙」，不要像慌亂逃跑。人物身份要明確：主角媽媽、主角小女孩。不可有文字、數字、門牌或標籤。"
    }
  ],

  "approvedSentences": [
    {
      "id": "L244-S01",
      "text": "夜市裡，店家忙著工作。",
      "spokenText": "夜市裡店家忙著工作",
      "focusChar": "忙",
      "displayLines": [
        "夜市裡，",
        "店家忙著",
        "工作。"
      ],
      "imageNotes": "夜市場景，夜市店家老闆或店員正在忙著整理攤位、準備商品或開始工作。可有主角小女孩和主角媽媽在安全邊界外看著夜市，但畫面重點是店家忙著工作。人物身份要明確：夜市店家老闆或店員、主角小女孩、主角媽媽。不可有文字、數字、招牌、價格牌或標籤。"
    },
    {
      "id": "L244-S02",
      "text": "我幫忙把工具放回盒子裡。",
      "spokenText": "我幫忙把工具放回盒子裡",
      "focusChar": "幫",
      "displayLines": [
        "我幫忙",
        "把工具",
        "放回盒子裡。"
      ],
      "imageNotes": "主角小女孩在家裡或活動桌旁幫忙收拾，把安全的工具放回盒子裡。工具可包含鈍頭剪刀、膠水瓶外形、刷子或尺形物，但不能有文字、數字、品牌或標籤。人物身份要明確：主角小女孩。"
    },
    {
      "id": "L244-S03",
      "text": "老師叫我幫忙做手作道具。",
      "spokenText": "老師叫我幫忙做手作道具",
      "focusChar": "幫",
      "displayLines": [
        "老師叫我",
        "幫忙做",
        "手作道具。"
      ],
      "imageNotes": "教室或活動教室場景，老師請主角小女孩幫忙做手作道具，桌上有紙、色塊材料和安全手作材料。老師要依 LESSON_VISUAL_CAST_SOP 設計，不可以長得像主角媽媽；不要用媽媽的黃色或珊瑚紅配色，不要像家庭角色。人物身份要明確：老師、主角小女孩。不可有文字、數字或標籤。"
    },
    {
      "id": "L244-S04",
      "text": "工人太忙了，我去幫他洗車。",
      "spokenText": "工人太忙了我去幫他洗車",
      "focusChar": "幫",
      "displayLines": [
        "工人太忙了，",
        "我去幫他",
        "洗車。"
      ],
      "imageNotes": "洗車場或家門口安全場景，一位洗車工人正在忙著洗車，主角小女孩拿著小海綿或小水桶在旁邊幫忙。人物身份要明確：洗車工人、主角小女孩。不可有品牌文字、車牌號碼、招牌或標籤。"
    },
    {
      "id": "L244-S05",
      "text": "媽媽說我真是好幫手。",
      "spokenText": "媽媽說我真是好幫手",
      "focusChar": "幫",
      "displayLines": [
        "媽媽說我",
        "真是好幫手。"
      ],
      "imageNotes": "家庭場景，主角媽媽溫和地稱讚主角小女孩是好幫手。畫面可呈現主角小女孩剛幫忙收拾玩具、擦桌子或把東西放好，媽媽在旁邊微笑。主角媽媽要依 L154/L162/L163 主角家庭 reference，不可畫成老師。人物身份要明確：主角媽媽、主角小女孩。不可有文字、數字或標籤。"
    }
  ],

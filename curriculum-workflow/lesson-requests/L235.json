  "approvedSentences": [
    {
      "id": "L235-S01",
      "text": "魚賣得不貴。",
      "spokenText": "魚賣得不貴",
      "focusChar": "賣",
      "displayLines": [
        "魚賣得",
        "不貴。"
      ],
      "imageNotes": "主角小女孩和主角媽媽在市場魚攤前，看著幾條魚，魚販正在賣魚，媽媽覺得魚賣得不貴。魚販是一般市場攤販，不能長得像主角媽媽或老師。畫面要呈現「魚正在被賣，而且不貴」的情境，但不可有價目表、文字、數字、招牌、品牌或標籤。"
    },
    {
      "id": "L235-S02",
      "text": "這本舊書可以賣錢。",
      "spokenText": "這本舊書可以賣錢",
      "focusChar": "賣",
      "displayLines": [
        "這本舊書",
        "可以賣錢。"
      ],
      "imageNotes": "主角小女孩和主角媽媽在家裡整理書，桌上有一本舊但完整的書，旁邊有少量硬幣或空錢罐，媽媽像是在說這本舊書可以賣錢。畫面要清楚表現「舊書可以拿去賣換錢」，但書封、書頁、錢罐、硬幣和桌面不可有文字、數字、品牌或標籤。"
    },
    {
      "id": "L235-S03",
      "text": "小馬賣力跑，還是不夠快。",
      "spokenText": "小馬賣力跑還是不夠快",
      "focusChar": "賣",
      "displayLines": [
        "小馬賣力跑，",
        "還是不夠快。"
      ],
      "imageNotes": "一匹小馬在草地或安全跑道上很努力地跑，姿勢用力、表情認真，但旁邊可有另一匹馬或跑道前方距離暗示牠還是不夠快。畫面重點是「小馬很賣力跑，但速度還不夠快」。不可有文字、數字、跑道號碼、標籤或招牌。"
    },
    {
      "id": "L235-S04",
      "text": "新書包太貴，先不買。",
      "spokenText": "新書包太貴先不買",
      "focusChar": "貴",
      "displayLines": [
        "新書包太貴，",
        "先不買。"
      ],
      "imageNotes": "主角小女孩和主角媽媽在家裡或店裡看一個新書包，小女孩喜歡但主角媽媽溫和地表示新書包太貴，先不買。畫面要清楚呈現「想買新書包，但覺得太貴所以先不買」。書包、錢、桌面和背景不可有文字、數字、價格、品牌或標籤。"
    },
    {
      "id": "L235-S05",
      "text": "買菜的錢還剩一點。",
      "spokenText": "買菜的錢還剩一點",

  "approvedSentences": [
    {
      "id": "L257-S01",
      "text": "媽媽累了，坐在椅子上睡著了。",
      "spokenText": "媽媽累了坐在椅子上睡著了",
      "focusChar": "睡",
      "displayLines": [
        "媽媽累了，",
        "坐在椅子上",
        "睡著了。"
      ],
      "imageNotes": "主角媽媽工作或家務後很累，坐在椅子上睡著了。主角媽媽身份要符合 L154/L162/L163 family continuity，不可畫成老師；畫面溫和安靜，不可有文字、數字、標籤或水印。"
    },
    {
      "id": "L257-S02",
      "text": "爸爸睡死了，什麼都聽不見。",
      "spokenText": "爸爸睡死了什麼都聽不見",
      "focusChar": "死",
      "displayLines": [
        "爸爸睡死了，",
        "什麼都",
        "聽不見。"
      ],
      "imageNotes": "主角爸爸在家裡熟睡，主角小女孩或主角媽媽在旁邊小聲叫他，但爸爸完全沒聽見。畫面要表現「睡死了」是睡得很熟的誇張口語，不可呈現死亡、受傷或恐怖畫面；不可有文字、數字、標籤或水印。"
    },
    {
      "id": "L257-S03",
      "text": "玩沙玩得太累，一到家就睡著。",
      "spokenText": "玩沙玩得太累一到家就睡著",
      "focusChar": "睡",
      "displayLines": [
        "玩沙玩得",
        "太累，",
        "一到家",
        "就睡著。"
      ],
      "imageNotes": "主角小女孩在海邊或沙地玩沙後回到家，坐在沙發或椅子旁很快睡著。畫面可帶一點沙地玩耍後的物品，例如小沙桶或鞋上的沙，但場景在家裡；不可有文字、數字、標籤或水印。"
    },
    {
      "id": "L257-S04",
      "text": "這一步死棋，不能改了。",
      "spokenText": "這一步死棋不能改了",
      "focusChar": "死",
      "displayLines": [
        "這一步死棋，",
        "不能改了。"
      ],
      "imageNotes": "主角爸爸和主角小女孩在家裡下棋，棋盤上有一步明顯走錯，兩人看著棋盤思考。畫面重點是棋局，不要出現任何死亡、恐怖或暴力意象；不可有文字、數字、標籤或水印。"
    },
    {
      "id": "L257-S05",
      "text": "床邊有一張小椅子。",
      "spokenText": "床邊有一張小椅子",
      "focusChar": "椅",
      "displayLines": [
        "床邊有",
        "一張小椅子。"
      ],
      "imageNotes": "乾淨溫暖的臥室裡，床邊放著一張小椅子，床和椅子的相對位置要清楚。畫面不需要人物；不可有文字、數字、標籤或水印。"
    }

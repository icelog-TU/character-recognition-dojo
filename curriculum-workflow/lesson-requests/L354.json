  "approvedSentences": [
    {
      "id": "L354-S01",
      "text": "餐廳沒有位子，我們正在等。",
      "spokenText": "餐廳沒有位子我們正在等",
      "focusChar": "餐",
      "displayLines": [
        "餐廳沒有",
        "位子，",
        "我們正在等。"
      ],
      "imageNotes": "餐廳入口或等候區，主角小女孩和主角家人正在等位子，餐廳裡座位已滿或沒有空位。不要可讀招牌、菜單文字、號碼、品牌或標誌。"
    },
    {
      "id": "L354-S02",
      "text": "請排在小光後面。",
      "spokenText": "請排在小光後面",
      "focusChar": "排",
      "displayLines": [
        "請排在",
        "小光後面。"
      ],
      "imageNotes": "學校或教室排隊場景，老師正在請主角小女孩排在小光後面。小光必須使用固定角色 reference：public/assets/reference/lesson-cast/xiaoguang.webp；不要畫成 generic classmate，也不要畫成既有「你」小男孩。畫面要清楚表現「在小光後面」，不要使用文字標示。"
    },
    {
      "id": "L354-S03",
      "text": "老師讓學生排排坐。",
      "spokenText": "老師讓學生排排坐",
      "focusChar": "排",
      "displayLines": [
        "老師讓學生",
        "排排坐。"
      ],
      "imageNotes": "教室或活動室裡，老師讓學生坐成整齊一排或幾排。學生可使用 generic classmates，但不要誤畫成小月或小光，除非畫面中明確需要他們。老師要和主角媽媽不同，不要可讀黑板字或標語。"
    },
    {
      "id": "L354-S04",
      "text": "我的位子正好排在小月前面。",
      "spokenText": "我的位子正好排在小月前面",
      "focusChar": "排",
      "displayLines": [
        "我的位子",
        "正好排在",
        "小月前面。"
      ],
      "imageNotes": "教室座位或排隊位置，主角小女孩的位子正好在小月前面，前後位置要清楚。小月必須使用固定角色 reference：public/assets/reference/lesson-cast/xiaoyue.webp；不要畫成 generic classmate，也不要畫成主角女孩。不要使用姓名牌、座號或可讀文字。"
    },
    {
      "id": "L354-S05",
      "text": "我們在飯店大廳用餐。",
      "spokenText": "我們在飯店大廳用餐",
      "focusChar": "餐",
      "displayLines": [
        "我們在飯店",
        "大廳用餐。"
      ],
      "imageNotes": "飯店寬敞大廳裡的用餐場景，主角小女孩和主角家人在大廳桌邊用餐。要看得出是飯店大廳，不是家裡飯廳；可有沙發、櫃台遠景、寬敞公共空間，但不要可讀招牌、房號、菜單文字、品牌或標誌。"
    }

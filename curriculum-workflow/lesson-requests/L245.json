  "approvedSentences": [
    {
      "id": "L245-S01",
      "text": "有急事，就叫人幫忙。",
      "spokenText": "有急事就叫人幫忙",
      "focusChar": "急",
      "displayLines": [
        "有急事，",
        "就叫人幫忙。"
      ],
      "imageNotes": "家庭或學校走廊場景，主角小女孩遇到需要協助的急事，開口叫附近可信任的人幫忙。可畫主角小女孩指向掉落或打翻的物品，旁邊有老師或主角媽媽準備協助。人物身份要明確：主角小女孩、老師或主角媽媽。不可有文字、數字或標籤。"
    },
    {
      "id": "L245-S02",
      "text": "車子要開走了，我很著急。",
      "spokenText": "車子要開走了我很著急",
      "focusChar": "急",
      "displayLines": [
        "車子要開走了，",
        "我很著急。"
      ],
      "imageNotes": "車站或路邊安全場景，一輛車準備開走，主角小女孩和主角媽媽站在安全位置，主角小女孩看起來很著急。車子不可有車牌號碼、路線文字、數字、標誌或標籤。人物身份要明確：主角小女孩、主角媽媽。"
    },
    {
      "id": "L245-S03",
      "text": "老師叫我幫忙做手作道具。",
      "spokenText": "老師叫我幫忙做手作道具",
      "focusChar": "幫",
      "displayLines": [
        "老師叫我幫忙",
        "做手作道具。"
      ],
      "imageNotes": "教室或活動教室場景，老師請主角小女孩幫忙做手作道具，桌上有紙、色塊材料和安全手作材料。老師要依 LESSON_VISUAL_CAST_SOP 設計，不可以長得像主角媽媽；不要用媽媽的黃色或珊瑚紅配色，不要像家庭角色。人物身份要明確：老師、主角小女孩。不可有文字、數字或標籤。"
    },
    {
      "id": "L245-S04",
      "text": "工人拿著工具，忙著工作。",
      "spokenText": "工人拿著工具忙著工作",
      "focusChar": "忙",
      "displayLines": [
        "工人拿著工具，",
        "忙著工作。"
      ],
      "imageNotes": "安全的工作場景，一位工人拿著工具忙著工作。可畫工人在整理或修理一個沒有文字標籤的簡單物件，例如桌子、木板或設備外殼。人物身份要明確：工人。不可有文字、數字、招牌、品牌或標籤。"
    },
    {
      "id": "L245-S05",
      "text": "雨後的河水流得很急。",
      "spokenText": "雨後的河水流得很急",
      "focusChar": "急",
      "displayLines": [
        "雨後的河水",
        "流得很急。"
      ],
      "imageNotes": "雨後的小河河水流得很快，水面有明顯流動感。主角小女孩和主角媽媽站在安全距離外看河水，不靠近水邊。畫面重點是雨後河水流得很急，而不是危險災害場面。人物身份要明確：主角小女孩、主角媽媽。不可有文字、數字、警示牌或標籤。"
    }
  ],

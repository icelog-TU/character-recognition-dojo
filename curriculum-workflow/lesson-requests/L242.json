  "approvedSentences": [
    {
      "id": "L242-S01",
      "text": "老師把手作道具放在桌上。",
      "spokenText": "老師把手作道具放在桌上",
      "focusChar": "作",
      "displayLines": [
        "老師把",
        "手作道具",
        "放在桌上。"
      ],
      "imageNotes": "老師在教室裡把手作道具放在桌上，道具可以是紙做的面具、手工玩具或簡單教具。老師要使用 recurring teacher identity，不能長得像主角媽媽。桌面、道具和教室背景不可有文字、數字、品牌或標籤。"
    },
    {
      "id": "L242-S02",
      "text": "很多人在夜市工作。",
      "spokenText": "很多人在夜市工作",
      "focusChar": "工",
      "displayLines": [
        "很多人",
        "在夜市",
        "工作。"
      ],
      "imageNotes": "夜市裡有很多不同店家和攤販正在工作，例如整理物品、賣東西或收拾攤位。可有主角小女孩和主角媽媽走過夜市。夜市工作者要是不同角色，不能都長得像主角媽媽或老師。不可有文字、數字、招牌、價格、品牌或標籤。"
    },
    {
      "id": "L242-S03",
      "text": "半夜的市場很黑。",
      "spokenText": "半夜的市場很黑",
      "focusChar": "夜",
      "displayLines": [
        "半夜的市場",
        "很黑。"
      ],
      "imageNotes": "半夜的市場已經關了，攤位安靜，燈很少，整體很黑但安全清楚。可從遠處看見市場空蕩，不要做成恐怖畫面。不可有文字、數字、招牌、價格、品牌或標籤。"
    },
    {
      "id": "L242-S04",
      "text": "作家的工具就是筆。",
      "spokenText": "作家的工具就是筆",
      "focusChar": "作",
      "displayLines": [
        "作家的工具",
        "就是筆。"
      ],
      "imageNotes": "一位作家在家中或書桌前工作，桌上主要工具是一枝筆，旁邊可有紙本或空白稿紙但不可有可讀文字。作家是獨立成人角色，不能長得像主角媽媽或老師。畫面要清楚呈現「作家的工具就是筆」。不可有文字、數字、品牌或標籤。"
    },
    {
      "id": "L242-S05",
      "text": "工作桌上放著很多工具。",
      "spokenText": "工作桌上放著很多工具",
      "focusChar": "工",
      "displayLines": [
        "工作桌上",
        "放著很多",
        "工具。"
      ],
      "imageNotes": "一張工作桌上整齊放著很多安全工具，例如刷子、小木槌、尺形工具或簡單手作工具；不要有危險尖銳感。可有主角小女孩在旁邊看，但不要讓她拿危險工具。不可有文字、數字、品牌或標籤。"
    }
  ],

  "approvedSentences": [
    {
      "id": "L243-S01",
      "text": "夜市開了，店家忙著工作。",
      "spokenText": "夜市開了店家忙著工作",
      "focusChar": "忙",
      "displayLines": [
        "夜市開了，",
        "店家忙著",
        "工作。"
      ],
      "imageNotes": "夜市剛開始營業，夜市店家老闆或店員忙著整理攤位、擺放商品或準備開店工作。可有主角小女孩和主角媽媽從安全邊界外看著夜市開始熱鬧，但畫面重點是店家忙著工作。人物身份要明確：夜市店家老闆或店員、主角小女孩、主角媽媽。不可有文字、數字、招牌、價格牌或標籤。"
    },
    {
      "id": "L243-S02",
      "text": "我忙著做手作面具。",
      "spokenText": "我忙著做手作面具",
      "focusChar": "忙",
      "displayLines": [
        "我忙著做",
        "手作面具。"
      ],
      "imageNotes": "主角小女孩坐在桌前，專心忙著用紙、顏色材料和安全剪貼工具做一個手作面具。面具可以已經有形狀但不能有文字、數字或標籤。畫面重點是孩子忙著做手作，不要出現恐怖面具。"
    },
    {
      "id": "L243-S03",
      "text": "工人拿著工具，忙著洗車。",
      "spokenText": "工人拿著工具忙著洗車",
      "focusChar": "忙",
      "displayLines": [
        "工人拿著",
        "工具，",
        "忙著洗車。"
      ],
      "imageNotes": "洗車場或家門口安全場景，一位洗車工人拿著洗車工具，忙著清洗車子。工具可包含海綿、水桶、刷子或水管，但不可有品牌文字、車牌號碼、招牌或標籤。人物身份要明確：洗車工人。"
    },
    {
      "id": "L243-S04",
      "text": "手作道具都放回盒子裡。",
      "spokenText": "手作道具都放回盒子裡",
      "focusChar": "具",
      "displayLines": [
        "手作道具",
        "都放回",
        "盒子裡。"
      ],
      "imageNotes": "主角小女孩和老師在活動結束後，把桌上的手作道具放回盒子裡。老師要依 LESSON_VISUAL_CAST_SOP 設計，不能長得像主角媽媽；不要用媽媽的黃色或珊瑚紅配色，不要像家庭場景。畫面重點是手作道具被收進盒子。不可有文字、數字或標籤。"
    },
    {
      "id": "L243-S05",
      "text": "雨停了，媽媽忙著擦地。",
      "spokenText": "雨停了媽媽忙著擦地",
      "focusChar": "忙",
      "displayLines": [
        "雨停了，",
        "媽媽忙著",
        "擦地。"
      ],
      "imageNotes": "家裡門口或室內靠近門邊的地面有雨後帶進來的水，主角媽媽忙著用布或拖把擦地，主角小女孩站在旁邊。主角媽媽要依 L154/L162/L163 主角家庭 reference，不可畫成老師。畫面重點是雨停後媽媽忙著擦地。不可有文字、數字或標籤。"
    }
  ],

  "approvedSentences": [
    {
      "id": "L361-S01",
      "text": "從帽子裡變出鳥，好驚奇！",
      "spokenText": "從帽子裡變出鳥好驚奇",
      "focusChar": "驚",
      "displayLines": [
        "從帽子裡",
        "變出鳥，",
        "好驚奇！"
      ],
      "imageNotes": "室內小小魔術表演場景，主角小女孩看著一位表演者從黑色帽子裡變出一隻小鳥，表情驚奇開心。小鳥從帽子裡飛出來，畫面清楚表現「變出鳥」。不要舞台文字、招牌、數字或可讀標籤。"
    },
    {
      "id": "L361-S02",
      "text": "怪物玩具讓我大吃一驚。",
      "spokenText": "怪物玩具讓我大吃一驚",
      "focusChar": "驚",
      "displayLines": [
        "怪物玩具",
        "讓我",
        "大吃一驚。"
      ],
      "imageNotes": "主角小女孩打開盒子或看到桌上的怪物玩具，被嚇一跳、往後退一點。怪物是玩具，要可愛、不恐怖，有玩具材質感。畫面表現「看到怪物玩具而吃驚」，不要恐怖電影感。"
    },
    {
      "id": "L361-S03",
      "text": "公園裡有奇怪的動物。",
      "spokenText": "公園裡有奇怪的動物",
      "focusChar": "奇",
      "displayLines": [
        "公園裡有",
        "奇怪的動物。"
      ],
      "imageNotes": "公園裡，主角小女孩看見一隻長相奇怪但可愛安全的動物，例如顏色特別、尾巴很長或耳朵很大的小動物。旁邊有草地、樹和公園長椅，畫面清楚是公園。不要做成動物園，不要文字告示牌。"
    },
    {
      "id": "L361-S04",
      "text": "媽媽老是大驚小怪。",
      "spokenText": "媽媽老是大驚小怪",
      "focusChar": "驚",
      "displayLines": [
        "媽媽老是",
        "大驚小怪。"
      ],
      "imageNotes": "主角小女孩手上只有一點點小擦傷，沒有流血或嚴重受傷；主角媽媽在旁邊表情很緊張，拿著小藥盒或 OK 繃準備處理。主角小女孩反而有點困惑或安撫媽媽。畫面要表現「小事被媽媽反應得很大」，不要恐怖、不要嚴重受傷。"
    },
    {
      "id": "L361-S05",
      "text": "小狗跑出來，我吃了一驚。",
      "spokenText": "小狗跑出來我吃了一驚",
      "focusChar": "驚",
      "displayLines": [
        "小狗跑出來，",
        "我吃了一驚。"
      ],
      "imageNotes": "主角小女孩站在家門口或院子旁，一隻小狗突然從門後或草叢旁跑出來，女孩露出吃驚表情但沒有害怕大哭。小狗要友善可愛，動作明顯。不要危險追逐、不要攻擊感。"
    }
  ],

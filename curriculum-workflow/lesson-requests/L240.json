  "approvedSentences": [
    {
      "id": "L240-S01",
      "text": "我在夜市買了面具。",
      "spokenText": "我在夜市買了面具",
      "focusChar": "具",
      "displayLines": [
        "我在夜市",
        "買了面具。"
      ],
      "imageNotes": "主角小女孩和主角媽媽在夜市的面具攤前，主角小女孩拿著或剛買到一個面具。夜市攤販是清楚的攤販角色，不能長得像主角媽媽或老師。面具和攤位不可有文字、數字、價格、品牌或標籤。"
    },
    {
      "id": "L240-S02",
      "text": "球具放在球場邊。",
      "spokenText": "球具放在球場邊",
      "focusChar": "具",
      "displayLines": [
        "球具放在",
        "球場邊。"
      ],
      "imageNotes": "球場邊放著球具，例如球、球棒、帽子或球具袋，位置清楚在球場旁邊。畫面重點是「球具放在球場邊」。不可有文字、數字、球衣號碼、品牌或標籤。"
    },
    {
      "id": "L240-S03",
      "text": "夜晚的市場，店家都關了。",
      "spokenText": "夜晚的市場店家都關了",
      "focusChar": "夜",
      "displayLines": [
        "夜晚的市場，",
        "店家都關了。"
      ],
      "imageNotes": "夜晚的市場安靜下來，很多店家和攤位都已經關門或收起來，燈光較暗但安全清楚。可以有主角小女孩和主角媽媽從遠處看見市場已經關了。店面和攤位不可有文字、數字、招牌、價格、品牌或標籤。"
    },
    {
      "id": "L240-S04",
      "text": "這家店賣很多玩具。",
      "spokenText": "這家店賣很多玩具",
      "focusChar": "具",
      "displayLines": [
        "這家店賣",
        "很多玩具。"
      ],
      "imageNotes": "一家玩具店或小店裡有很多玩具，店家角色正在整理玩具，主角小女孩和主角媽媽在旁邊看。店家角色不能長得像主角媽媽或老師。玩具、店面和背景不可有文字、數字、價格、品牌或標籤。"
    },
    {
      "id": "L240-S05",
      "text": "老師把道具放在桌上。",
      "spokenText": "老師把道具放在桌上",
      "focusChar": "具",
      "displayLines": [
        "老師把道具",
        "放在桌上。"
      ],
      "imageNotes": "老師在教室裡把上課用的道具放在桌上，道具可以是面具、球、紙做的物品或簡單教具，但不要出現文字。老師要使用 recurring teacher identity，不能長得像主角媽媽。桌面、道具和教室背景不可有文字、數字、品牌或標籤。"

  "approvedSentences": [
    {
      "id": "L236-S01",
      "text": "書店裡賣很多書。",
      "spokenText": "書店裡賣很多書",
      "focusChar": "店",
      "displayLines": [
        "書店裡",
        "賣很多書。"
      ],
      "imageNotes": "書店室內場景，架上有很多沒有可讀文字的書，書店店主正在整理或賣書，主角小女孩和主角媽媽在旁邊看書。書店店主需是清楚的店家角色，不能長得像主角媽媽或老師。不可有書名、文字、數字、招牌、品牌或標籤。"
    },
    {
      "id": "L236-S02",
      "text": "這家店的魚不貴。",
      "spokenText": "這家店的魚不貴",
      "focusChar": "店",
      "displayLines": [
        "這家店的魚",
        "不貴。"
      ],
      "imageNotes": "市場魚店或魚攤場景，魚店賣魚的人展示幾條魚，主角小女孩和主角媽媽看著魚，感覺這家店的魚不貴。魚店賣魚的人要和主角媽媽、老師長相明顯不同。不可有價目表、文字、數字、招牌、品牌或標籤。"
    },
    {
      "id": "L236-S03",
      "text": "媽媽在店裡買菜。",
      "spokenText": "媽媽在店裡買菜",
      "focusChar": "店",
      "displayLines": [
        "媽媽在店裡",
        "買菜。"
      ],
      "imageNotes": "主角媽媽在菜店或菜攤前買菜，主角小女孩在旁邊看著，桌上有新鮮蔬菜。菜店賣菜的人是店家角色，不能長得像主角媽媽或老師。不可有價目表、文字、數字、招牌、品牌或標籤。"
    },
    {
      "id": "L236-S04",
      "text": "有人在海邊開小店賣水。",
      "spokenText": "有人在海邊開小店賣水",
      "focusChar": "店",
      "displayLines": [
        "有人在海邊",
        "開小店賣水。"
      ],
      "imageNotes": "海邊有一間小店，海邊小店店主正在賣沒有標籤的水，旁邊可有路人或遊客買水，但不要指定主角爸爸或任何固定家庭角色在開店。畫面要清楚呈現「海邊小店賣水」。不可有文字、數字、招牌、價格、品牌或標籤。"
    },
    {
      "id": "L236-S05",

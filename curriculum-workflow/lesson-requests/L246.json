  "approvedSentences": [
    {
      "id": "L246-S01",
      "text": "工人手忙腳亂，工具掉了。",
      "spokenText": "工人手忙腳亂工具掉了",
      "focusChar": "腳",
      "displayLines": [
        "工人手忙",
        "腳亂，",
        "工具掉了。"
      ],
      "imageNotes": "安全的工作場景，一位工人正在工作時手忙腳亂，手上的工具掉到地上。畫面要表現慌亂但不可危險，不要有受傷情節。人物身份要明確：工人。工具不可有品牌、文字、數字或標籤。"
    },
    {
      "id": "L246-S02",
      "text": "我急急忙忙光著腳出門。",
      "spokenText": "我急急忙忙光著腳出門",
      "focusChar": "腳",
      "displayLines": [
        "我急急忙忙",
        "光著腳出門。"
      ],
      "imageNotes": "主角小女孩在家門口急急忙忙要出門，還光著腳，鞋子放在門邊沒有穿上。主角媽媽可在旁邊提醒或拿鞋，但不要讓畫面像危險逃跑。人物身份要明確：主角小女孩、主角媽媽。不可有文字、數字或標籤。"
    },
    {
      "id": "L246-S03",
      "text": "山腳下的河水流得很急。",
      "spokenText": "山腳下的河水流得很急",
      "focusChar": "腳",
      "displayLines": [
        "山腳下的",
        "河水",
        "流得很急。"
      ],
      "imageNotes": "山腳下有一條小河，雨後河水流得很快。主角小女孩和主角媽媽站在安全距離外看河水，不靠近水邊。畫面重點是山腳下的位置與河水流得很急，不要做災害場面。人物身份要明確：主角小女孩、主角媽媽。不可有文字、數字、警示牌或標籤。"
    },
    {
      "id": "L246-S04",
      "text": "車要開走了，媽媽幫我拿包。",
      "spokenText": "車要開走了媽媽幫我拿包",
      "focusChar": "幫",
      "displayLines": [
        "車要開走了，",
        "媽媽幫我",
        "拿包。"
      ],
      "imageNotes": "車站或路邊安全場景，一輛車準備開走，主角媽媽幫主角小女孩拿包，主角小女孩看起來趕著要上車但保持安全距離。車子不可有車牌號碼、路線文字、數字、標誌或標籤。人物身份要明確：主角媽媽、主角小女孩。"
    },
    {
      "id": "L246-S05",
      "text": "老師叫我幫忙做手作道具。",
      "spokenText": "老師叫我幫忙做手作道具",
      "focusChar": "作",
      "displayLines": [
        "老師叫我",
        "幫忙做",
        "手作道具。"
      ],
      "imageNotes": "教室或活動教室場景，老師請主角小女孩幫忙做手作道具，桌上有紙、色塊材料和安全手作材料。老師要依 LESSON_VISUAL_CAST_SOP 設計，不可以長得像主角媽媽；不要用媽媽的黃色或珊瑚紅配色，不要像家庭角色。人物身份要明確：老師、主角小女孩。不可有文字、數字或標籤。"
    }
  ],

  "approvedSentences": [
    {
      "id": "L247-S01",
      "text": "爸爸幫小孩一步一步走。",
      "spokenText": "爸爸幫小孩一步一步走",
      "focusChar": "步",
      "displayLines": [
        "爸爸幫小孩",
        "一步一步走。"
      ],
      "imageNotes": "主角爸爸在家裡或安全空地，溫和地扶著一個小孩一步一步學走路。小孩可以是主角小女孩較小時的樣子，或一位明確的幼兒角色；不要使用「妹妹」身份，因為句子沒有寫妹妹。人物身份要明確：主角爸爸、小孩。不可有文字、數字或標籤。"
    },
    {
      "id": "L247-S02",
      "text": "他聽見腳步聲，急著回頭。",
      "spokenText": "他聽見腳步聲急著回頭",
      "focusChar": "步",
      "displayLines": [
        "他聽見",
        "腳步聲，",
        "急著回頭。"
      ],
      "imageNotes": "固定「他」男孩在走廊、家門口或安全路邊聽見身後的腳步聲，急著回頭看。畫面要表現他聽見腳步聲後回頭，不要做恐怖或危險情境。人物身份要明確：固定「他」男孩；可有一位路人或家人在背景遠處走來，但不可模糊成不明人士。不可有文字、數字或標籤。"
    },
    {
      "id": "L247-S03",
      "text": "脫下鞋子放在腳邊。",
      "spokenText": "脫下鞋子放在腳邊",
      "focusChar": "腳",
      "displayLines": [
        "脫下鞋子",
        "放在腳邊。"
      ],
      "imageNotes": "主角小女孩在家門口或室內地墊上，把鞋子脫下來放在自己的腳邊。畫面要清楚看到鞋子已脫下並放在腳邊，不要有文字、數字、門牌或標籤。人物身份要明確：主角小女孩。"
    },
    {
      "id": "L247-S04",
      "text": "先想好，不要急著動手做。",
      "spokenText": "先想好不要急著動手做",
      "focusChar": "急",
      "displayLines": [
        "先想好，",
        "不要急著",
        "動手做。"
      ],
      "imageNotes": "主角小女孩坐在桌前準備做一件小手作或簡單積木作品，先停下來想一想，還沒有急著動手做。桌上可有紙、積木或安全材料，但不要出現文字、數字、圖表或標籤。人物身份要明確：主角小女孩。"
    },
    {
      "id": "L247-S05",
      "text": "畫家作畫，不用人幫忙。",
      "spokenText": "畫家作畫不用人幫忙",
      "focusChar": "作",
      "displayLines": [
        "畫家作畫，",
        "不用人幫忙。"
      ],
      "imageNotes": "一位畫家在畫室或戶外架著畫架專心作畫，旁邊的人沒有伸手幫忙，只是在旁邊安靜觀看。畫面重點是畫家自己作畫，不需要別人幫忙。人物身份要明確：畫家、旁邊觀看的路人或主角小女孩。畫布上不可有文字、數字、可辨識標籤或水印。"
    }
  ],

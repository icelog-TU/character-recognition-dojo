  "approvedSentences": [
    {
      "id": "L365-S01",
      "text": "這個怪物很嚇人，但又很好笑。",
      "spokenText": "這個怪物很嚇人但又很好笑",
      "focusChar": "但",
      "displayLines": [
        "這個怪物",
        "很嚇人，",
        "但又很好笑。"
      ],
      "imageNotes": "主角小女孩看著一個怪物玩具或怪物裝扮，怪物外表有一點嚇人但表情和動作很好笑，例如做出笨拙滑稽的姿勢。女孩一開始有點驚訝，接著笑出來。怪物不能太恐怖，不能有血、尖銳攻擊或驚悚感。"
    },
    {
      "id": "L365-S02",
      "text": "我喜歡小狗，但是怕大狗。",
      "spokenText": "我喜歡小狗但是怕大狗",
      "focusChar": "但",
      "displayLines": [
        "我喜歡小狗，",
        "但是怕大狗。"
      ],
      "imageNotes": "主角小女孩開心摸一隻友善小狗，同一畫面遠一點有一隻體型大的狗，她看向大狗時有點害怕、躲在媽媽或爸爸旁邊。大狗要看起來大但安全，不能攻擊或露出兇狠表情。"
    },
    {
      "id": "L365-S03",
      "text": "我吃了一驚，但是沒有哭。",
      "spokenText": "我吃了一驚但是沒有哭",
      "focusChar": "但",
      "displayLines": [
        "我吃了一驚，",
        "但是沒有哭。"
      ],
      "imageNotes": "主角小女孩打開盒子或門後看到一個突然出現的小玩具，露出吃驚表情，但沒有哭，表情是驚訝後穩住自己。畫面要清楚表現「吃驚但沒有哭」，不要恐怖。"
    },
    {
      "id": "L365-S04",
      "text": "爸爸說笑話，但是沒人笑。",
      "spokenText": "爸爸說笑話但是沒人笑",
      "focusChar": "笑",
      "displayLines": [
        "爸爸說笑話，",
        "但是沒人笑。"
      ],
      "imageNotes": "主角爸爸在家中客廳說笑話，表情期待；主角小女孩和媽媽或家人坐在旁邊，大家沒有笑，表情平靜或有點困惑。不要文字對話框、字幕或可讀笑話內容。"
    },
    {
      "id": "L365-S05",
      "text": "這個驚喜很奇怪，但是我喜歡。",
      "spokenText": "這個驚喜很奇怪但是我喜歡",
      "focusChar": "但",
      "displayLines": [
        "這個驚喜",
        "很奇怪，",
        "但是我喜歡。"
      ],
      "imageNotes": "主角小女孩打開禮物盒，看到裡面是一個造型奇怪但可愛的小玩具，例如怪物帽子、奇怪造型玩偶或會彈出的趣味玩具。她一開始驚訝，後來露出喜歡的表情。不要恐怖、不要品牌或包裝文字。"
    }
  ],

  "approvedSentences": [
    {
      "id": "L251-S01",
      "text": "床很重，搬不動。",
      "spokenText": "床很重搬不動",
      "focusChar": "重",
      "displayLines": [
        "床很重，",
        "搬不動。"
      ],
      "imageNotes": "家裡房間場景，一張床看起來很重，主角爸爸或搬家工人試著搬床但搬不動。畫面要清楚表現床很重、搬不動，但不要危險或受傷。人物身份要明確：主角爸爸或搬家工人。不可有文字、數字、標籤或品牌。"
    },
    {
      "id": "L251-S02",
      "text": "帽子和鞋子太多，我幫忙搬。",
      "spokenText": "帽子和鞋子太多我幫忙搬",
      "focusChar": "搬",
      "displayLines": [
        "帽子和鞋子",
        "太多，",
        "我幫忙搬。"
      ],
      "imageNotes": "家裡整理或搬家前的場景，帽子和鞋子很多，主角小女孩幫忙把帽子和鞋子搬到一旁或搬進盒子附近。畫面重點是帽子和鞋子太多、孩子幫忙搬。人物身份要明確：主角小女孩；可有主角媽媽在旁邊整理。不可有文字、數字、品牌或標籤。"
    },
    {
      "id": "L251-S03",
      "text": "門外腳步聲很重。",
      "spokenText": "門外腳步聲很重",
      "focusChar": "重",
      "displayLines": [
        "門外腳步聲",
        "很重。"
      ],
      "imageNotes": "家裡門內視角或走廊場景，門外有人腳步聲很重，主角小女孩在門內聽見聲音。畫面不要恐怖或危險，可用門外路人或主角爸爸沉穩走過來表示重重的腳步聲。人物身份要明確：主角小女孩；門外人物可為主角爸爸或路人。不可有門牌、文字、數字或標籤。"
    },
    {
      "id": "L251-S04",
      "text": "小狗跳上床，又跳下床。",
      "spokenText": "小狗跳上床又跳下床",
      "focusChar": "跳",
      "displayLines": [
        "小狗跳上床，",
        "又跳下床。"
      ],
      "imageNotes": "家裡房間場景，小狗在床旁邊跳上床又跳下床。畫面要清楚呈現床和小狗上下跳的動作，但不要危險或弄亂房間。可有主角小女孩在旁邊看著。人物身份若出現要明確：主角小女孩。不可有文字、數字或標籤。"
    },
    {
      "id": "L251-S05",
      "text": "這一步很重要，不能做錯。",
      "spokenText": "這一步很重要不能做錯",
      "focusChar": "重",
      "displayLines": [
        "這一步",
        "很重要，",
        "不能做錯。"
      ],
      "imageNotes": "主角小女孩正在做一個需要按步驟完成的手作、積木或簡單拼圖，停在很重要的一步，表情專心，知道不能做錯。畫面要讓觀眾理解是某個步驟很重要，但不要出現步驟文字、數字、圖表或標籤。人物身份要明確：主角小女孩。"
    }
  ],

  "approvedSentences": [
    {
      "id": "L397-S01",
      "text": "這雙鞋子太小，腳好痛。",
      "spokenText": "這雙鞋子太小腳好痛",
      "displayLines": [
        "這雙鞋子",
        "太小，",
        "腳好痛。"
      ],
      "focusChar": "雙",
      "imageNotes": "鞋店試穿區，主角小女孩坐在矮凳上，雙腳穿著同一雙鞋，低頭摸著鞋子前端，皺眉表示腳趾被擠得不舒服。主角媽媽蹲在旁邊查看鞋頭。兩隻鞋都要入鏡，不畫紅腫或受傷。"
    },
    {
      "id": "L397-S02",
      "text": "把菜單翻過來看，雙面都有印。",
      "spokenText": "把菜單翻過來看雙面都有印",
      "displayLines": [
        "把菜單",
        "翻過來看，",
        "雙面都有印。"
      ],
      "focusChar": "雙",
      "imageNotes": "餐廳桌旁，主角媽媽指著女孩手中的單張雙面菜單，提醒她翻面查看。女孩正在翻轉菜單，新露出的背面印有清楚的料理圖片。不是翻書式菜單，不出現影印機；情境是查看已印好的菜單，不是交代印製。菜名和價格不需可讀。老師最後補字為「翻過來看」，所有文字與音訊必須包含「看」。"
    },
    {
      "id": "L397-S03",
      "text": "請幫我影印兩張報名單。",
      "spokenText": "請幫我影印兩張報名單",
      "displayLines": [
        "請幫我影印",
        "兩張報名單。"
      ],
      "focusChar": "印",
      "imageNotes": "影印店櫃台前，主角爸爸把一張報名單原稿遞給工作人員，同時伸出兩根手指表示需要兩張。主角小女孩在旁陪同，工作人員後方有影印機。原稿呈現表格線與填寫欄位，不需可讀文字。畫面停在提出要求，尚未出現完成的影本。本句「我」是爸爸。"
    },
    {
      "id": "L397-S04",
      "text": "翻到下一頁，找出電話號碼。",
      "spokenText": "翻到下一頁找出電話號碼",
      "displayLines": [
        "翻到下一頁，",
        "找出",
        "電話號碼。"
      ],
      "focusChar": "翻",
      "imageNotes": "家中桌旁，主角爸爸陪女孩看活動介紹小冊子。女孩剛翻到下一頁，爸爸指向新頁面下方的電話聯絡區，女孩順著查看。頁面可有泳池或球場插圖，交代活動資訊。電話圖示旁清楚印「00-0000-0000」；使用此虛構號碼，不加入真實個資或其他可讀文字。老師已批准本課數字入圖。"
    },
    {
      "id": "L397-S05",
      "text": "我用雙手接住爸爸的球。",
      "spokenText": "我用雙手接住爸爸的球",
      "displayLines": [
        "我用雙手接住",
        "爸爸的球。"
      ],
      "focusChar": "雙",
      "imageNotes": "公園草地上，主角爸爸與主角小女孩面對面玩傳接球。女孩雙手同時扶住一顆球的兩側，球已穩穩接在胸前；爸爸站在幾步外，保持剛傳球後的姿勢。只畫一顆球，不加飛行殘影，雙手接球的動作必須清楚。"
    }

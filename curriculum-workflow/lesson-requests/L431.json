  "approvedSentences": [
    {
      "id": "L431-S01",
      "text": "主人不在，由我照顧小狗。",
      "spokenText": "主人不在由我照顧小狗",
      "displayLines": [
        "主人不在，",
        "由我照顧",
        "小狗。"
      ],
      "focusChar": "由",
      "imageNotes": "熟識鄰居外出，將小狗暫時託付主角家照顧。主角小女孩在媽媽陪同下，把裝好的飼料碗放到小狗面前，旁邊備有飲水與狗床；媽媽在旁照看，不代替女孩完成動作。這隻狗是受託照顧的鄰居小狗，不是主角家原有寵物，也不是陌生流浪犬。主人不在畫面中，不畫成孩子獨自在家負責一切。",
      "approved": true
    },
    {
      "id": "L431-S02",
      "text": "店員說，這些花可以自由選。",
      "spokenText": "店員說這些花可以自由選",
      "displayLines": [
        "店員說，",
        "這些花可以",
        "自由選。"
      ],
      "focusChar": "由",
      "imageNotes": "花店裡，generic adult 店員張手示意面前幾桶可供搭配花束的鮮花，讓主角小女孩自行挑選喜歡的花；主角媽媽陪在旁邊。女孩正指向其中一種花，店員準備取出搭配。表達可在指定範圍選花，不是免費贈送，也不是任意採走店裡所有花。無價牌文字或數字。",
      "approved": true
    },
    {
      "id": "L431-S03",
      "text": "我自己選的書，主角是小魚。",
      "spokenText": "我自己選的書主角是小魚",
      "displayLines": [
        "我自己",
        "選的書，",
        "主角是小魚。"
      ],
      "focusChar": "主",
      "imageNotes": "家中閱讀角，主角小女孩把親自挑選的繪本展示給主角爸爸看，指著書中居於畫面中心的小魚角色。書頁以連貫的水中插畫呈現，小魚外觀可辨識、是主要角色，沒有可讀書名或內文。不要畫成魚類圖鑑、家中水族箱，或女孩正在畫魚。",
      "approved": true,
      "zhuyinOverrides": {
        "7": "ㄐㄧㄠˇ"
      }
    },
    {
      "id": "L431-S04",
      "text": "我會自己穿衣，不用幫忙。",
      "spokenText": "我會自己穿衣不用幫忙",
      "displayLines": [
        "我會",
        "自己穿衣，",
        "不用幫忙。"

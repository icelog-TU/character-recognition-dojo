  "approvedSentences": [
    {
      "id": "L309-S01",
      "text": "我忘了給小鳥水喝。",
      "spokenText": "我忘了給小鳥水喝",
      "focusChar": "忘",
      "displayLines": [
        "我忘了給",
        "小鳥水喝。"
      ],
      "imageNotes": "主角小女孩看著小鳥旁邊空空的水碗，突然想起忘了給小鳥水喝。小鳥要健康可愛，不要痛苦；不可有文字、數字、標籤。"
    },
    {
      "id": "L309-S02",
      "text": "媽媽照顧生病的爸爸。",
      "spokenText": "媽媽照顧生病的爸爸",
      "focusChar": "顧",
      "displayLines": [
        "媽媽照顧",
        "生病的爸爸。"
      ],
      "imageNotes": "主角媽媽在家裡照顧生病的主角爸爸，爸爸坐在床邊或躺著休息，主角小女孩在旁邊看著。畫面溫和，不要嚴重醫療或恐怖感；不可有文字、數字、標籤。"
    },
    {
      "id": "L309-S03",
      "text": "只顧著看書，忘了澆花。",
      "spokenText": "只顧著看書忘了澆花",
      "focusChar": "忘",
      "displayLines": [
        "只顧著看書，",
        "忘了澆花。"
      ],
      "imageNotes": "主角小女孩坐著看書，看得很專心，旁邊有一盆還沒澆水的花。畫面要清楚呈現只顧著看書、忘了澆花；書頁不可有可讀文字、數字或標籤。"
    },
    {
      "id": "L309-S04",
      "text": "種在房裡的小花照不到陽光。",
      "spokenText": "種在房裡的小花照不到陽光",
      "focusChar": "照",
      "displayLines": [
        "種在房裡的小花",
        "照不到陽光。"
      ],
      "imageNotes": "一盆小花種在花盆裡，花盆放在房間裡比較暗的地方，窗外有陽光但照不到小花。畫面要清楚呈現小花在房裡照不到陽光；不要畫成花種在地板裡，不可有文字、數字、標籤。"
    },
    {
      "id": "L309-S05",
      "text": "忘了澆水，土變得很乾。",
      "spokenText": "忘了澆水土變得很乾",
      "focusChar": "忘",
      "displayLines": [
        "忘了澆水，",
        "土變得很乾。"
      ],
      "imageNotes": "花盆或小菜園裡的土因為忘了澆水而變得很乾，主角小女孩看著乾乾的土。畫面要清楚呈現忘了澆水、土變乾；不可有文字、數字、標籤。"
    }

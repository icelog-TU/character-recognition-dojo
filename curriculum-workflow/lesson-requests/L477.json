  "approvedSentences": [
    {
      "id": "L477-S01",
      "text": "因為大雨的緣故，河水很急。",
      "spokenText": "因為大雨的緣故河水很急",
      "displayLines": [
        "因為大雨的",
        "緣故，",
        "河水很急。"
      ],
      "focusChar": "緣",
      "zhuyinOverrides": {
        "1": "ㄨㄟˋ"
      },
      "imageNotes": "大雨中的河道，水量明顯增加，水面有急流、浪花，岸邊草木被雨打濕。主角女孩和主角爸爸站在有屋頂、護欄的安全觀景處望著河水。人物不靠近水邊、不下水。雨和急流同時可見，不能只畫平靜晴天河景，也不災難化。"
    },
    {
      "id": "L477-S02",
      "text": "這本故事書字大，而且圖多。",
      "spokenText": "這本故事書字大而且圖多",
      "displayLines": [
        "這本故事書",
        "字大，",
        "而且圖多。"
      ],
      "focusChar": "故",
      "zhuyinOverrides": {
        "3": "ㄕˋ"
      },
      "imageNotes": "家中主角女孩與主角媽媽一起翻看大開本故事書。攤開頁面以大幅插圖為主，只留少量大字的文字區，字大、圖多同時可見。文字不要求辨讀，不指定可讀漢字、書名或內容；不要密密麻麻小字，也不要把頁面全部畫成沒有字區。老師批准的是版面比例，不是清楚文字／數字入圖例外。"
    },
    {
      "id": "L477-S03",
      "text": "小光很熱心，而且人緣很好。",
      "spokenText": "小光很熱心而且人緣很好",
      "displayLines": [
        "小光很熱心，",
        "而且人緣",
        "很好。"
      ],
      "focusChar": "緣",
      "imageNotes": "教室裡，固定小光幫 generic 同學撿掉落文具，對方開心向他道謝；旁邊主角女孩和固定小月笑著招手，等小光一起玩。用主動幫忙及同學喜歡找他表現熱心、人緣好，不畫成集體鼓掌或小光受獎。小光用 public/assets/reference/lesson-cast/xiaoguang.webp；小月用 public/assets/reference/lesson-cast/xiaoyue.webp；兩個 named cast 都不能畫成 generic 或主角女孩。"
    },
    {
      "id": "L477-S04",
      "text": "圖案在反面，把紙翻過來。",
      "spokenText": "圖案在反面把紙翻過來",
      "displayLines": [
        "圖案在反面，",
        "把紙翻過來。"
      ],
      "focusChar": "反",
      "imageNotes": "家中桌邊，主角女孩原本看一張紙的空白面，主角媽媽提醒；女孩正把紙翻過來，露出另一面的彩色小狗圖案。用同一張紙的翻動呈現正反面，不是兩張紙。老師已放棄「在反面邊緣畫圖案」的手工情境，本定稿沒有邊緣，不得加回。"
    },
    {
      "id": "L477-S05",
      "text": "我們又見面了，真有緣！",
      "spokenText": "我們又見面了真有緣",
      "displayLines": [
        "我們又",
        "見面了，",
        "真有緣！"
      ],
      "focusChar": "緣",
      "imageNotes": "外地海邊遊玩步道，主角女孩和主角爸爸散步，意外遇見與家人出遊的小月。兩個女孩驚喜認出彼此、揮手打招呼，雙方家長微笑停步。不是約好同行，也不是天天在教室見面。小月依 fixed reference；陪同她的是小月家長，未建固定參考時用明確區別主角父母的 generic 家長，不把主角媽媽畫成小月媽媽。"
    }
  ],

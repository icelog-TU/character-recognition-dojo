  "approvedSentences": [
    {
      "id": "L239-S01",
      "text": "晚上，媽媽帶我去夜市。",
      "spokenText": "晚上媽媽帶我去夜市",
      "focusChar": "夜",
      "displayLines": [
        "晚上，媽媽",
        "帶我去夜市。"
      ],
      "imageNotes": "主角媽媽帶主角小女孩晚上去夜市，夜市入口和燈光很熱鬧，但不能有任何可讀文字或招牌。畫面要清楚呈現「晚上去夜市」。主角媽媽與主角小女孩使用既有家庭角色設定。不可有文字、數字、招牌、價格、品牌或標籤。"
    },
    {
      "id": "L239-S02",
      "text": "夜市裡有人賣帽子。",
      "spokenText": "夜市裡有人賣帽子",
      "focusChar": "夜",
      "displayLines": [

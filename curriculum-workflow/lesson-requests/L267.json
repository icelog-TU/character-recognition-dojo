  "approvedSentences": [
    {
      "id": "L267-S01",
      "text": "玩太久，要休息一下。",
      "spokenText": "玩太久要休息一下",
      "focusChar": "久",
      "displayLines": [
        "玩太久，",
        "要休息一下。"
      ],
      "imageNotes": "主角小女孩在家裡或安全遊戲區玩太久，坐下來休息一下。畫面要清楚表現玩了一段時間後休息；不可有文字、數字、標籤或注音。"
    },
    {
      "id": "L267-S02",
      "text": "剛剛看書太久，很想睡。",
      "spokenText": "剛剛看書太久很想睡",
      "focusChar": "久",
      "displayLines": [
        "剛剛看書太久，",
        "很想睡。"
      ],
      "imageNotes": "主角小女孩剛剛看書太久，坐在書桌旁或床邊揉眼睛、打呵欠，很想睡。書頁不可出現可讀文字、數字或注音。"
    },
    {
      "id": "L267-S03",
      "text": "這場病，休養了很久。",
      "spokenText": "這場病休養了很久",
      "focusChar": "久",
      "displayLines": [
        "這場病，",
        "休養了很久。"
      ],
      "imageNotes": "主角小女孩生病後在家休養，主角媽媽在旁邊照顧，氣氛溫和，不要做成嚴重醫療場景。不可有文字、數字、藥品標籤或注音。"
    },
    {
      "id": "L267-S04",
      "text": "裝了很久，才把沙發裝好。",
      "spokenText": "裝了很久才把沙發裝好",
      "focusChar": "裝",
      "displayLines": [
        "裝了很久，",
        "才把沙發裝好。"
      ],
      "imageNotes": "主角爸爸在家裡組裝沙發，主角小女孩在旁邊幫忙或觀看，沙發剛裝好，旁邊可有沒有文字的工具零件。不可有說明書文字、數字、標籤或注音。"
    },
    {
      "id": "L267-S05",
      "text": "多休息，才能早點把病養好。",
      "spokenText": "多休息才能早點把病養好",
      "focusChar": "息",
      "displayLines": [
        "多休息，",
        "才能早點把病養好。"
      ],
      "imageNotes": "主角媽媽溫和提醒生病中的主角小女孩多休息，才能早點養好病。畫面可在臥室或客廳，主角小女孩躺著或坐著休息；不可有文字、數字、藥品標籤或注音。"
    }

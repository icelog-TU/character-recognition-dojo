  "approvedSentences": [
    {
      "id": "L419-S01",
      "text": "這套衣服很合身，我決定買了。",
      "spokenText": "這套衣服很合身我決定買了",
      "displayLines": [
        "這套衣服",
        "很合身，",
        "我決定買了。"
      ],
      "focusChar": "合",
      "imageNotes": "服飾店試衣區，主角小女孩剛換上準備購買的一套上衣與褲子，在鏡子前查看；主角媽媽站在旁邊陪她。衣服肩線、袖長、腰部與褲長都恰當，不鬆垮也不緊繃。女孩滿意地轉頭向媽媽表示決定購買，尚未結帳或提著購物袋離店。女孩維持既有臉型、髮型與髮夾身份特徵，但服裝依本課試穿情境更換。不要用尺寸、價錢或文字標籤表達合身。",
      "approved": true
    },
    {
      "id": "L419-S02",
      "text": "如果合作，就能快點畫完。",
      "spokenText": "如果合作就能快點畫完",
      "displayLines": [
        "如果合作，",
        "就能快點",
        "畫完。"
      ],
      "focusChar": "合",
      "imageNotes": "小學美術活動，桌上攤著一張大型圖畫，只有部分花草與房子畫好，仍有大片空白。主角小女孩原本一人拿筆作畫，老師向女孩與另一名 generic 同學提議一起完成；同學剛拿起畫筆準備加入。畫面是合作的提議與準備開始，不是已完成的作品。兩名孩子面對同一張紙，避免畫成各畫各的。generic 同學不冒充小月、小光或既有固定同學。圖畫中不加入可讀標語。",
      "approved": true
    },
    {
      "id": "L419-S03",
      "text": "不如合力把桌子搬出去。",
      "spokenText": "不如合力把桌子搬出去",
      "displayLines": [
        "不如合力",
        "把桌子",
        "搬出去。"
      ],
      "focusChar": "合",
      "imageNotes": "家中整理空間，主角爸爸站在一張桌子的一端，停下獨自搬動的嘗試；主角媽媽走到另一端，提出兩人一起搬出去的建議。兩人正準備握住桌子兩側，桌腳仍落地，尚未搬到門外。通往庭院或門外的路線平坦、淨空，不設樓梯或狹窄障礙。主角小女孩可以站在安全距離觀看，但不參與抬重物。桌子大小與重量要讓兩名成人合作搬動合理，不畫成小孩一人就能拿走的迷你桌。",
      "approved": true
    },
    {
      "id": "L419-S04",
      "text": "盒子上的結太緊，我解不開。",
      "spokenText": "盒子上的結太緊我解不開",
      "displayLines": [
        "盒子上的結",
        "太緊，",
        "我解不開。"
      ],
      "focusChar": "解",
      "imageNotes": "家中桌前，主角小女孩正在拆一個禮物盒。盒蓋仍關著，盒外繫帶的結纏得很緊；女孩用手指試著鬆開，未能成功，抬頭向旁邊的主角妈妈說明困難。媽媽正查看，尚未接手解開。構圖清楚呈現盒子、綁帶與緊結，不改成鞋帶，也不要畫成漂亮且已經鬆開的蝴蝶結。不需剪刀，不畫拆開後的禮物內容。",
      "approved": true
    },

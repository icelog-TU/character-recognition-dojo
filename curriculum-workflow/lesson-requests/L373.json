  "approvedSentences": [
    {
      "id": "L373-S01",
      "text": "我跟朋友交換玩具，感情更好。",
      "spokenText": "我跟朋友交換玩具感情更好",
      "focusChar": "交",
      "displayLines": [
        "我跟朋友",
        "交換玩具，",
        "感情更好。"
      ],
      "imageNotes": "主角小女孩和小月坐在遊戲墊旁。女孩把自己的玩具車遞給小月，小月同時把自己的玩具小船遞給女孩。兩人微笑看著對方，開心地交換玩具。清楚呈現雙方各拿出一件玩具交換，不是只有一方送東西。小月使用 public/assets/reference/lesson-cast/xiaoyue.webp。",
      "approved": true
    },
    {
      "id": "L373-S02",
      "text": "朋友親口通知我，他要轉學了。",
      "spokenText": "朋友親口通知我他要轉學了",
      "focusChar": "通",
      "displayLines": [
        "朋友親口",
        "通知我，",
        "他要轉學了。"
      ],
      "imageNotes": "放學後，固定「他」運動型小男孩和主角小女孩站在教室外。男孩面向女孩，認真告訴她即將轉學的消息。女孩專心聽，露出驚訝、捨不得的表情。男孩的無文字想像泡泡裡，畫他背著書包走進另一所外觀明顯不同的學校，讓孩子理解「轉學」。泡泡中的男孩與眼前人物須一致。不要畫成搬家，不放校名或告示文字。「他」使用固定運動型男孩身份，不可套用「你」或小光。",
      "approved": true
    },
    {
      "id": "L373-S03",
      "text": "媽媽正在跟親友通電話。",
      "spokenText": "媽媽正在跟親友通電話",
      "focusChar": "通",
      "displayLines": [
        "媽媽正在跟",
        "親友通電話。"
      ],
      "imageNotes": "主角家客廳裡，媽媽拿著電話，神情輕鬆地聊天。畫面另一側用小幅分隔場景，呈現一位 generic 成年女性親友在自己家中接電話，微笑回應。兩處背景明顯不同，表達兩人不在同一個地方。親友外貌不能像媽媽。電話螢幕不放文字或號碼。",
      "approved": true
    },
    {
      "id": "L373-S04",
      "text": "火車和船都是交通工具。",
      "spokenText": "火車和船都是交通工具",
      "focusChar": "通",
      "displayLines": [
        "火車和船都是",
        "交通工具。"
      ],
      "imageNotes": "河岸旁，一列火車行駛在鐵軌上，河面有一艘載客的船。兩者完整、清楚可辨，能看見車窗與船上的 generic 乘客，呈現載人移動的用途。採開闊構圖，火車與船各有自己的行進空間，不互相遮擋。不放車號、船名、標誌或文字。",
      "approved": true
    },
    {
      "id": "L373-S05",
      "text": "把窗打開，讓房間通風。",
      "spokenText": "把窗打開讓房間通風",
      "focusChar": "通",
      "displayLines": [
        "把窗打開，",
        "讓房間通風。"
      ],
      "imageNotes": "主角媽媽站在房門旁，示意打開窗戶；主角爸爸正把窗打開。窗外有明亮的樹景，窗簾隨微風輕輕飄動，房門也保持開啟。以打開的窗、房門與輕動窗簾呈現空氣流通，不用文字、箭頭或誇張風線。主角小女孩可站在媽媽身旁觀看，不靠近窗邊攀爬。",
      "approved": true
    }
  ],

  "approvedSentences": [
    {
      "id": "L237-S01",
      "text": "這家店賣的魚不貴。",
      "spokenText": "這家店賣的魚不貴",
      "focusChar": "店",
      "displayLines": [
        "這家店",
        "賣的魚",
        "不貴。"
      ],
      "imageNotes": "市場魚店或魚攤場景，魚店賣魚的人展示幾條魚，主角小女孩和主角媽媽看著魚，感覺這家店賣的魚不貴。魚店賣魚的人是清楚的店家角色，不能長得像主角媽媽或老師。不可有價目表、文字、數字、招牌、品牌或標籤。"
    },
    {
      "id": "L237-S02",
      "text": "有人在球場賣水。",
      "spokenText": "有人在球場賣水",
      "focusChar": "場",
      "displayLines": [
        "有人在球場",
        "賣水。"
      ],
      "imageNotes": "球場旁有一位賣水的人正在賣沒有標籤的水，附近有幾個孩子或路人在球場活動。賣水的人是路邊攤販角色，不能長得像主角媽媽或老師。畫面要清楚呈現「球場有人賣水」。不可有文字、數字、招牌、價格、品牌或標籤。"
    },
    {
      "id": "L237-S03",
      "text": "球場邊有一家小店。",
      "spokenText": "球場邊有一家小店",
      "focusChar": "場",
      "displayLines": [
        "球場邊",
        "有一家小店。"
      ],
      "imageNotes": "球場邊有一間小店，小店外觀簡單，旁邊可見球場與活動中的孩子。小店不能有招牌文字或任何可讀標示。畫面重點是「小店在球場邊」。不可有文字、數字、招牌、價格、品牌或標籤。"
    },
    {
      "id": "L237-S04",
      "text": "一場大雨過後，地上有水。",
      "spokenText": "一場大雨過後地上有水",
      "focusChar": "場",
      "displayLines": [
        "一場大雨",
        "過後，",
        "地上有水。"
      ],
      "imageNotes": "大雨剛停後的戶外場景，地上有明顯積水，天空雲散開，路邊樹葉或草地濕濕的。可有主角小女孩站在安全處看著地上的水，但不要讓她踩進深水。畫面要清楚呈現「一場大雨過後，地上有水」。不可有文字、數字、招牌或標籤。"
    },
    {
      "id": "L237-S05",
      "text": "眼鏡太貴，錢不夠買。",
      "spokenText": "眼鏡太貴錢不夠買",
      "focusChar": "貴",
      "displayLines": [
        "眼鏡太貴，",
        "錢不夠買。"
      ],
      "imageNotes": "主角小女孩和主角媽媽在眼鏡店或家裡看一副眼鏡，小女孩需要或想買眼鏡，但主角媽媽看著手上的錢，表示眼鏡太貴，錢不夠買。畫面要清楚呈現「眼鏡太貴，錢不夠買」。眼鏡、錢、桌面和背景不可有文字、數字、價格、品牌或標籤。"
    }

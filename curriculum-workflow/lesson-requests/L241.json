  "approvedSentences": [
    {
      "id": "L241-S01",
      "text": "夜市的手工面具很好看。",
      "spokenText": "夜市的手工面具很好看",
      "focusChar": "工",
      "displayLines": [
        "夜市的手工",
        "面具很好看。"
      ],
      "imageNotes": "夜市裡有手工面具攤，主角小女孩和主角媽媽看著幾個手工面具，覺得很好看。攤販是清楚的夜市攤販角色，不能長得像主角媽媽或老師。面具和攤位不可有文字、數字、價格、品牌或標籤。"
    },
    {
      "id": "L241-S02",
      "text": "這家店賣很多手工玩具。",
      "spokenText": "這家店賣很多手工玩具",
      "focusChar": "工",
      "displayLines": [
        "這家店賣",
        "很多手工",
        "玩具。"
      ],
      "imageNotes": "一家小店裡賣很多手工玩具，店家角色正在整理玩具，主角小女孩和主角媽媽在旁邊看。店家角色不能長得像主角媽媽或老師。玩具、店面和背景不可有文字、數字、價格、品牌或標籤。"
    },
    {
      "id": "L241-S03",
      "text": "有人在夜市打工。",
      "spokenText": "有人在夜市打工",
      "focusChar": "工",
      "displayLines": [
        "有人在夜市",
        "打工。"
      ],
      "imageNotes": "夜市攤位旁有一位正在打工的人幫忙整理物品或遞水，旁邊可有主角小女孩和主角媽媽經過。打工的人是一般夜市工作者角色，不能長得像主角媽媽或老師。不可有文字、數字、招牌、價格、品牌或標籤。"
    },
    {
      "id": "L241-S04",
      "text": "停車場的工人很賣力。",
      "spokenText": "停車場的工人很賣力",
      "focusChar": "工",
      "displayLines": [
        "停車場的",
        "工人很",
        "賣力。"
      ],
      "imageNotes": "停車場裡有工人在賣力工作，例如整理停車場、推小推車或清掃地面。工人要穿一般工作服但不可有文字或標誌，不能長得像主角媽媽或老師。畫面要清楚呈現「停車場的工人很賣力」。不可有車牌、文字、數字、招牌、品牌或標籤。"
    },
    {
      "id": "L241-S05",
      "text": "工具放在桌上。",
      "spokenText": "工具放在桌上",
      "focusChar": "工",
      "displayLines": [
        "工具放在",
        "桌上。"
      ],
      "imageNotes": "桌上整齊放著幾樣安全工具，例如無尖銳危險感的玩具工具、刷子、小木槌或簡單手作工具。可有主角小女孩在旁邊看，但不要讓她拿危險工具。畫面重點是「工具放在桌上」。不可有文字、數字、品牌或標籤。"
    }
  ],

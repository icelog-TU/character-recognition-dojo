  "approvedSentences": [
    {
      "id": "L358-S01",
      "text": "我們今天去動物園。",
      "spokenText": "我們今天去動物園",
      "focusChar": "物",
      "displayLines": [
        "我們今天去",
        "動物園。"
      ],
      "imageNotes": "主角小女孩和家人站在動物園入口附近，準備進去玩。畫面要看得出是動物園入口或園區外圍，但不要出現可讀招牌、園名、票價、地圖文字或標誌。",
      "targetCharIndex": 6
    },
    {
      "id": "L358-S02",
      "text": "動物園裡有公雞。",
      "spokenText": "動物園裡有公雞",
      "focusChar": "物",
      "displayLines": [
        "動物園裡",
        "有公雞。"
      ],
      "imageNotes": "動物園裡一個安全圍欄區，有一隻公雞站著或走動。可以有主角小女孩遠遠觀看。畫面要清楚呈現「動物園裡」和「公雞」，不要文字說明牌、園區標示或標誌。",
      "targetCharIndex": 1
    },
    {
      "id": "L358-S03",
      "text": "小雞也是動物。",
      "spokenText": "小雞也是動物",
      "focusChar": "物",
      "displayLines": [
        "小雞也是",
        "動物。"
      ],
      "imageNotes": "幾隻小雞在安全的小動物觀察區或草地上走動，主角小女孩在旁邊看。畫面重點是小雞本身，讓孩子理解小雞也是動物。不要文字、標籤或過度擬人化。",
      "targetCharIndex": 5
    },
    {
      "id": "L358-S04",
      "text": "雞媽媽後面跟著一排小雞。",
      "spokenText": "雞媽媽後面跟著一排小雞",
      "focusChar": "排",
      "displayLines": [
        "雞媽媽後面",
        "跟著一排",
        "小雞。"
      ],
      "imageNotes": "一隻母雞走在前面，後面跟著一排小雞，前後排列要清楚。場景可在草地或農家旁，畫面溫和安全，不要人物也可以。不要文字或標誌。",
      "targetCharIndex": 8
    },
    {
      "id": "L358-S05",
      "text": "公車正好停在動物園前。",
      "spokenText": "公車正好停在動物園前",
      "focusChar": "物",
      "displayLines": [
        "公車正好停在",
        "動物園前。"
      ],
      "imageNotes": "公車停在動物園入口前，主角小女孩和家人或同學準備下車或剛下車。要清楚看出公車停在動物園前，但不要路線號碼、站名、車牌、廣告或可讀招牌。",
      "targetCharIndex": 7
    }
  ],

  "approvedSentences": [
    {
      "id": "L253-S01",
      "text": "床頭上有一張畫。",
      "spokenText": "床頭上有一張畫",
      "focusChar": "張",
      "displayLines": [
        "床頭上",
        "有一張畫。"
      ],
      "imageNotes": "主角小女孩的房間場景，床頭上方或床頭邊有一張畫。畫本身可以是簡單圖案或風景，但畫上不可有文字、數字、簽名、標籤或水印。人物若出現要明確：主角小女孩。不可有文字、數字或標籤。"
    },
    {
      "id": "L253-S02",
      "text": "桌上放著很多筆和紙張。",
      "spokenText": "桌上放著很多筆和紙張",
      "focusChar": "張",
      "displayLines": [
        "桌上放著",
        "很多筆和",
        "紙張。"
      ],
      "imageNotes": "桌面場景，桌上放著很多筆和幾張紙張，像是畫畫或寫字前的準備。紙張必須是空白或只有無文字的色塊/圖形，不可有文字、數字、注音、品牌或標籤。可以有主角小女孩在桌邊準備使用。人物若出現要明確：主角小女孩。"
    },
    {
      "id": "L253-S03",
      "text": "沙發邊有一張桌子。",
      "spokenText": "沙發邊有一張桌子",
      "focusChar": "張",
      "displayLines": [
        "沙發邊有",
        "一張桌子。"
      ],
      "imageNotes": "家裡客廳場景，沙發旁邊有一張桌子。畫面要清楚呈現沙發和一張桌子的相對位置。人物可不出現；若出現，人物身份要明確：主角小女孩或主角媽媽。不可有文字、數字、品牌或標籤。"
    },
    {
      "id": "L253-S04",
      "text": "沙發太重，要等搬家工人來搬。",
      "spokenText": "沙發太重要等搬家工人來搬",
      "focusChar": "搬",
      "displayLines": [
        "沙發太重，",
        "要等搬家",
        "工人來搬。"
      ],
      "imageNotes": "搬家場景，一張沙發太重，主角家庭在旁邊等待搬家工人來搬。搬家工人可以準備搬沙發，但不要危險或受傷。人物身份要明確：搬家工人、主角爸爸或主角媽媽、主角小女孩。不可有文字、數字、車牌、品牌、箱子標籤或招牌。"
    },
    {
      "id": "L253-S05",
      "text": "河馬太重了，跳不起來。",
      "spokenText": "河馬太重了跳不起來",
      "focusChar": "重",
      "displayLines": [
        "河馬太重了，",
        "跳不起來。"
      ],
      "imageNotes": "溫和有趣的動物場景，一隻河馬因為身體很重，試著跳但跳不起來。畫面可略帶幽默，不要嘲笑人類體重，不要危險或受傷。可以在河邊、草地或動物園感覺的自然環境，但不可有文字、數字、招牌或標籤。"
    }
  ],

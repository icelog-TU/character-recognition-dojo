  "approvedSentences": [
    {
      "id": "L407-S01",
      "text": "關上窗，風聲就減弱了。",
      "spokenText": "關上窗風聲就減弱了",
      "displayLines": [
        "關上窗，",
        "風聲就",
        "減弱了。"
      ],
      "focusChar": "減",
      "imageNotes": "家中，主角小女孩剛把窗戶關好，手還放在窗把上，表情放鬆。窗外樹枝被風吹向一側，室內窗簾安靜垂下。表現關窗隔開風聲，不是外面的風停了；不要畫成颱風災害。",
      "approved": true
    },
    {
      "id": "L407-S02",
      "text": "書越來越多，家裡空間減少了。",
      "spokenText": "書越來越多家裡空間減少了",
      "displayLines": [
        "書越來越多，",
        "家裡空間",
        "減少了。"
      ],
      "focusChar": "減",
      "imageNotes": "家中閱讀角落，書架已放滿，旁邊地板又整齊堆著幾疊書，原本可活動的空間變小。主角小女孩抱著幾本書，主角媽媽正在找地方放。書堆低矮穩固，不畫成危險雜物山。",
      "approved": true
    },
    {
      "id": "L407-S03",
      "text": "三減二，再加一，算算看。",
      "spokenText": "三減二再加一算算看",
      "displayLines": [
        "三減二，",
        "再加一，",
        "算算看。"
      ],
      "focusChar": "減",
      "imageNotes": "家中桌邊，主角媽媽陪小女孩用積木算數。中央剩下一塊紅色積木，旁邊放著剛移走的兩塊紅色積木；媽媽正拿一塊藍色積木，準備加到中央。小女孩看著積木思考。數量與空間分組必須準確，不另加裝飾積木，不需要算式或數字。",
      "approved": true
    },
    {
      "id": "L407-S04",
      "text": "寫字時，下筆要有強有弱。",
      "spokenText": "寫字時下筆要有強有弱",
      "displayLines": [
        "寫字時，",
        "下筆要",
        "有強有弱。"
      ],
      "focusChar": "強",
      "imageNotes": "主角小女孩正在用毛筆寫字，老師在旁指導。近景呈現毛筆筆尖接觸紙面，以及粗細不同的墨色筆畫。紙上只露出局部筆畫，不要求生成完整可讀漢字；重點是下筆輕重造成筆畫變化。",
      "approved": true
    },
    {
      "id": "L407-S05",
      "text": "天冷了，睡前多加一床被子。",
      "spokenText": "天冷了睡前多加一床被子",
      "displayLines": [
        "天冷了，",
        "睡前多加",
        "一床被子。"
      ],
      "focusChar": "加",
      "imageNotes": "晚上，主角小女孩穿睡衣坐在床上，主角媽媽替她加被子。床上已有一床薄被，媽媽把另一床較厚的被子鋪上去，兩床被子的邊緣清楚可辨。呈現多加一床，不是換掉原本的被子。",
      "approved": true
    }
  ],

  "approvedSentences": [
    {
      "id": "L442-S01",
      "text": "影印機不能正常運轉，要修理。",
      "spokenText": "影印機不能正常運轉要修理",
      "displayLines": [
        "影印機不能",
        "正常運轉，",
        "要修理。"
      ],
      "focusChar": "機",
      "imageNotes": "影印店內，一台大型影印機停止正常出紙，出紙處露出卡住、皺折的紙張。generic 店員察看機器，主角女孩拿著待影印文件在旁等候。呈現機器故障、尚待修理，不是已經恢復運作。不要用冒煙、火花或誇張損壞表達故障；螢幕不出現文字、錯誤代碼或數字。",
      "approved": true
    },
    {
      "id": "L442-S02",
      "text": "這些水果是用飛機運來的。",
      "spokenText": "這些水果是用飛機運來的",
      "displayLines": [
        "這些水果",
        "是用飛機",
        "運來的。"
      ],
      "focusChar": "機",
      "imageNotes": "超市水果區，固定媽媽和主角女孩看著精緻包裝、整齊陳列的水果。女孩好奇，媽媽指著水果解釋運送方式。搭配一個小型說明泡泡，畫運輸飛機與成箱水果，表達這些水果先前經由空運抵達。主畫面必須在超市，不是機場裝貨現場；眼前水果已送達，不是準備被運走。無價牌、產地字樣、航空公司或品牌標誌。",
      "approved": true
    },
    {
      "id": "L442-S03",
      "text": "爸爸用手機看球賽。",
      "spokenText": "爸爸用手機看球賽",
      "displayLines": [
        "爸爸用手機",
        "看球賽。"
      ],
      "focusChar": "機",
      "imageNotes": "家中客廳，固定爸爸坐在沙發上，橫向拿著手機專心看籃球賽。從爸爸側後方構圖，可看見手機螢幕上兩隊球員和籃框，讓「用手機看球賽」清楚可辨。螢幕無字幕、比分、隊名、球衣號碼或 app 標誌；不是爸爸正在玩手機遊戲。",
      "approved": true
    },
    {
      "id": "L442-S04",
      "text": "我練習用手機照相。",
      "spokenText": "我練習用手機照相",
      "displayLines": [
        "我練習",
        "用手機照相。"
      ],
      "focusChar": "機",
      "zhuyinOverrides": {
        "7": "ㄒㄧㄤˋ"
      },
      "imageNotes": "花園裡，主角女孩用雙手拿穩手機，對準一朵花練習拍照；固定媽媽在旁示意她對好位置。採側後方視角，同時看見被拍的花與手機內對應的構圖。呈現女孩正在照相，不是看照片、打電話或自拍。螢幕可有簡單相機取景畫面，但無可讀文字、數字或品牌。",
      "approved": true
    },
    {
      "id": "L442-S05",
      "text": "這場練習賽，我們全隊都上場。",
      "spokenText": "這場練習賽我們全隊都上場",

  "approvedSentences": [
    {
      "id": "L228-S01",
      "text": "這衣服半新不舊，可是還能穿。",
      "spokenText": "這衣服半新不舊可是還能穿",
      "focusChar": "半",
      "displayLines": [
        "這衣服",
        "半新不舊，",
        "可是還能穿。"
      ],
      "imageNotes": "主角媽媽拿著一件半新不舊的衣服給主角小女孩看，衣服看起來不是全新，但也沒有壞，還可以穿。主角小女孩在旁邊準備穿或點頭接受。畫面要表現衣服有一點使用痕跡但仍然乾淨可穿；不可有文字、數字、尺寸標籤或品牌。"
    },
    {
      "id": "L228-S02",
      "text": "我認得一半新同學。",
      "spokenText": "我認得一半新同學",
      "focusChar": "半",
      "displayLines": [
        "我認得",
        "一半新同學。"
      ],
      "imageNotes": "主角小女孩站在教室或校園裡，看著一群新同學；其中幾個她表情熟悉、像是認得，另外幾個她還有點不確定。不能用文字、名字牌或數字標出「一半」。人物：主角小女孩 + 一群新同學。畫面重點是「認得其中一部分新同學」。"
    },
    {
      "id": "L228-S03",
      "text": "媽媽說做事要認真。",
      "spokenText": "媽媽說做事要認真",
      "focusChar": "認",
      "displayLines": [
        "媽媽說",
        "做事要認真。"
      ],
      "imageNotes": "主角媽媽在家中溫和提醒主角小女孩做事要認真。主角小女孩正在做一件可見的小事，例如整理書包、畫圖、摺衣服或收拾桌子，表情變得專心。人物：主角媽媽 + 主角小女孩。不可有文字、數字或標籤。"
    },
    {
      "id": "L228-S04",
      "text": "這半邊畫錯了，要改一改。",
      "spokenText": "這半邊畫錯了要改一改",
      "focusChar": "半",
      "displayLines": [
        "這半邊",
        "畫錯了，",
        "要改一改。"
      ],
      "imageNotes": "主角小女孩坐在桌前看著一張圖畫，圖的一半明顯畫錯或塗錯，另一半比較正確，她準備修改錯的那半邊。圖紙上只能有圖案，不可有字、數字或標籤。畫面要清楚呈現「半邊畫錯」和「準備改」。"
    },

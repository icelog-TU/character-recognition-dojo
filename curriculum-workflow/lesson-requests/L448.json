  "approvedSentences": [
    {
      "id": "L448-S01",
      "text": "歌聲一停，大家就拍手。",
      "spokenText": "歌聲一停大家就拍手",
      "focusChar": "歌",
      "displayLines": [
        "歌聲一停，",
        "大家就拍手。"
      ],
      "imageNotes": "小型社區表演現場，一位 generic adult singer 剛結束演出，已停止出聲並放低麥克風，微微鞠躬。觀眾開始拍手，前景包含主角女孩與固定主角媽媽，其他人為外貌各異的 generic audience。時間點是表演結束後的掌聲，不是歌手中途停頓、觀眾打拍子或老師叫大家停下。歌手不得直接套用主角媽媽或老師身份。",
      "approved": true
    },
    {
      "id": "L448-S02",
      "text": "我想和這位歌手一起拍照。",
      "spokenText": "我想和這位歌手一起拍照",
      "focusChar": "歌",
      "displayLines": [
        "我想和",
        "這位歌手",
        "一起拍照。"
      ],
      "imageNotes": "表演結束後，主角女孩靠近固定主角媽媽，期待地指向附近那位 generic adult singer，表達想一起拍照。媽媽手中拿著手機但尚未拍攝，歌手在旁與觀眾互動。「這位」必須有清楚的指向；沿用 S01 的 generic singer 外觀，形成同場活動延續。主畫面是提出合照願望，不是已經拍完照片，也不是偷拍歌手。手機不放品牌或可讀內容。",
      "approved": true
    },
    {
      "id": "L448-S03",
      "text": "這個樂器的聲音像鳥叫。",
      "spokenText": "這個樂器的聲音像鳥叫",
      "focusChar": "音",
      "displayLines": [
        "這個樂器的",
        "聲音像鳥叫。"
      ],
      "zhuyinOverrides": {
        "2": "ㄩㄝˋ"
      },
      "imageNotes": "樂器展示區，一位 generic adult demonstrator 正吹奏小型陶笛，主角女孩指向這一件樂器，專心聆聽。以女孩的小型想像泡泡呈現一隻張嘴鳴叫的小鳥，表達她覺得聲音像鳥叫。陶笛本體與吹奏動作要清楚，鳥只出現在想像泡泡，不畫成現場真的有鳥發聲。不要畫成女孩泛指整間店的所有樂器，也不用擬聲字或音符標籤。",
      "approved": true
    },
    {
      "id": "L448-S04",
      "text": "早操的音樂太快，我跟不上。",
      "spokenText": "早操的音樂太快我跟不上",
      "focusChar": "操",
      "displayLines": [
        "早操的音樂",
        "太快，",
        "我跟不上。"
      ],
      "zhuyinOverrides": {
        "4": "ㄩㄝˋ"
      },
      "imageNotes": "早晨學校操場，固定老師帶領孩子們隨音響播放的音樂做早操。老師與幾位 generic classmates 已換到下一個動作，主角女孩還停在前一個姿勢，邊看老師邊試著跟上，神情有些困惑。清楚呈現動作慢半拍，不畫成跑步落後、跌倒、受傷或被同學取笑。老師與主角媽媽身份必須區分。",
      "approved": true
    },
    {

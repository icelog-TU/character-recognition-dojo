  "approvedSentences": [
    {
      "id": "L374-S01",
      "text": "這條小路通往海邊。",
      "spokenText": "這條小路通往海邊",
      "focusChar": "往",
      "displayLines": [
        "這條小路",
        "通往海邊。"
      ],
      "imageNotes": "一條清楚的小路從畫面前景延伸到海邊沙灘，遠處可見海面與岸邊。道路必須連續可追蹤，讓孩子看懂沿著這條路就能到海邊。路旁有草與低矮樹木，不用文字路牌或箭頭。可不安排人物，重點是小路與目的地的空間關係。",
      "approved": true
    },
    {
      "id": "L374-S02",
      "text": "想交朋友，不說話行不通。",
      "spokenText": "想交朋友不說話行不通",
      "focusChar": "通",
      "displayLines": [
        "想交朋友，",
        "不說話",
        "行不通。"
      ],
      "imageNotes": "學校庭院裡，主角小女孩想接近固定「你」小男孩，站在他旁邊，手拿準備一起玩的球，神情有些猶豫，尚未開口。男孩正在看自己的玩具，還沒有注意到女孩的邀請。固定老師在女孩身旁，蹲下溫和鼓勵她主動打招呼。以尚未開始互動的狀態呈現「光站著不說，對方不知道想交朋友」。不要畫成男孩故意拒絕、嘲笑或排擠女孩。不要畫滿臉通紅，也不放文字對話泡泡。「你」使用固定短深髮、天藍上衣、綠短褲、藍鞋身份。老師須與主角媽媽不同。",
      "approved": true
    },
    {
      "id": "L374-S03",
      "text": "爸爸常跟親友來往。",
      "spokenText": "爸爸常跟親友來往",
      "focusChar": "往",
      "displayLines": [
        "爸爸常跟",
        "親友來往。"
      ],
      "imageNotes": "主角爸爸到熟悉的親友家拜訪。一位 generic 成年男性親友在門口微笑迎接，另一位 generic 成年女性親友在屋內準備茶水。爸爸輕鬆自然地打招呼，主角小女孩跟在身旁。呈現熟悉、自在的日常串門子，不是第一次認識或正式會議。親友外貌、服裝須與主角父母明顯不同。不增加相簿、文字或複雜時間線來硬表現「常」。",
      "approved": true
    },
    {
      "id": "L374-S04",
      "text": "我親手把圖交給老師。",
      "spokenText": "我親手把圖交給老師",
      "focusChar": "交",
      "displayLines": [
        "我親手把圖",
        "交給老師。"
      ],
      "imageNotes": "教室裡，主角小女孩正雙手把一張圖畫直接遞給固定老師，老師伸手接過。圖紙位於兩人之間，交接動作清楚可見，不能畫成放在桌上、請別人代交，或兩人各拿一張圖。作品只含簡單圖像，沒有可讀文字。本句與既有交圖場景相近：生成前先檢查可否重用已核准、語義與人物均吻合的圖片，在 packet 記錄 reuse decision；不能只因題材相近就直接沿用。",
      "approved": true
    },
    {
      "id": "L374-S05",
      "text": "往外走走，心情會好些。",
      "spokenText": "往外走走心情會好些",
      "focusChar": "往",
      "displayLines": [
        "往外走走，",
        "心情會好些。"
      ],
      "imageNotes": "主角小女孩在家門內，低著頭、肩膀微垂，心情不太好。主角媽媽陪在身旁，溫和地向門外伸手，邀請女孩一起出去走走。門外是明亮、安靜的步道與花草，女孩開始抬頭看向外面。呈現家人的陪伴與提議，不畫成女孩已經興高采烈，也不需要額外捏造嚴重事件作為難過原因。保持室內到室外的方向清楚。",
      "approved": true
    }
  ],

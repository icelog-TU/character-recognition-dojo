  "approvedSentences": [
    {
      "id": "L256-S01",
      "text": "這張沙發椅太重，搬到累死了。",
      "spokenText": "這張沙發椅太重搬到累死了",
      "focusChar": "死",
      "displayLines": [
        "這張沙發椅",
        "太重，",
        "搬到累死了。"
      ],
      "imageNotes": "主角爸爸和搬家工人在家裡搬一張很重的沙發椅，搬完後主角爸爸看起來非常累、坐下喘口氣或擦汗。畫面要表現「累死了」是誇張口語，不可呈現死亡、受傷或恐怖畫面；不可有文字、數字、標籤或水印。"
    },
    {
      "id": "L256-S02",
      "text": "沙地上跑來跑去，累得半死。",
      "spokenText": "沙地上跑來跑去累得半死",
      "focusChar": "累",
      "displayLines": [
        "沙地上",
        "跑來跑去，",
        "累得半死。"
      ],
      "imageNotes": "主角小女孩在海邊沙地上跑來跑去後，坐在沙地邊休息，看起來很累但安全。畫面要表現「累得半死」是誇張口語，不可呈現死亡、受傷、昏倒或恐怖畫面；不可有文字、數字、標籤或水印。"
    },
    {
      "id": "L256-S03",
      "text": "爸爸下了一步死棋。",
      "spokenText": "爸爸下了一步死棋",
      "focusChar": "死",
      "displayLines": [
        "爸爸下了",
        "一步死棋。"
      ],
      "imageNotes": "主角爸爸和主角小女孩在家裡下棋，棋盤上爸爸剛下了一步很糟的棋，主角小女孩看著棋盤露出驚訝或思考表情。畫面重點是棋局，不要出現任何死亡、恐怖或暴力意象；不可有文字、數字、標籤或水印。"
    },
    {
      "id": "L256-S04",
      "text": "死火山裡面，早就沒有火了。",
      "spokenText": "死火山裡面早就沒有火了",
      "focusChar": "死",
      "displayLines": [
        "死火山裡面，",
        "早就沒有",
        "火了。"
      ],
      "imageNotes": "自然地景中的安靜死火山，火山口內沒有火、沒有煙、沒有爆發，周圍可以有綠地或山石，畫面平靜安全。不可畫火山爆發、災難、岩漿、火焰、受傷人物；不可有文字、數字、標籤或水印。"
    },
    {
      "id": "L256-S05",
      "text": "那張小椅子不能坐了。",
      "spokenText": "那張小椅子不能坐了",
      "focusChar": "椅",
      "displayLines": [
        "那張小椅子",
        "不能坐了。"
      ],
      "imageNotes": "家裡一張小椅子明顯老舊或椅腳不穩，主角媽媽提醒主角小女孩不要坐。主角媽媽身份要符合 L154/L162/L163 family continuity，不可畫成老師；畫面要安全，不要畫孩子跌倒或受傷；不可有文字、數字、標籤或水印。"
    }

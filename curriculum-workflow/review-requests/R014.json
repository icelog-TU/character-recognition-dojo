  "teacherNotes": "Release integrated R014 on latest origin/main; provisional dependency fields cleared after dependency audit.",
  "approvedSentences": [
    {
      "text": "書上說，火星是行星。",
      "spokenText": "書上說火星是行星",
      "focusChar": "星",
      "displayLines": [
        "書上說，",
        "火星是行星。"
      ],
      "imageNotes": "主角小女孩在家裡或教室看一本天文圖畫書，書頁上可有火星和行星的圖像，但絕對不可出現文字、數字、星球名稱或標籤。人物身份要明確：主角小女孩。"
    },
    {
      "text": "早上，我走在人行道上。",
      "spokenText": "早上我走在人行道上",
      "focusChar": "道",
      "displayLines": [
        "早上，我走在",
        "人行道上。"
      ],
      "imageNotes": "早上戶外街道場景，主角小女孩安全地走在人行道上，旁邊可有樹、房子或路邊環境。不可出現交通標誌文字、路牌、店招、車牌號碼或標籤。人物身份要明確：主角小女孩。"
    },
    {
      "text": "晚上，電燈亮了。",
      "spokenText": "晚上電燈亮了",
      "focusChar": "電",
      "displayLines": [
        "晚上，",
        "電燈亮了。"
      ],
      "imageNotes": "晚上家裡房間場景，電燈打開變亮，房間被照亮。可有主角小女孩在房間裡看著亮起的燈。人物身份若出現要明確：主角小女孩。不可有文字、數字或標籤。"
    },
    {
      "text": "你的畫真有想像力。",
      "spokenText": "你的畫真有想像力",
      "focusChar": "想",
      "displayLines": [
        "你的畫",
        "真有想像力。"
      ],
      "imageNotes": "固定「你」男孩拿著或展示一張很有想像力的畫，畫裡可以有奇特但溫和的創意場景，例如會飛的小船或有翅膀的小火車，但畫面和畫紙上都不可有文字、數字或標籤。人物身份要明確：固定「你」男孩；可有主角小女孩在旁邊欣賞。"
    },
    {
      "text": "這門快壞了，不能太用力開。",
      "spokenText": "這門快壞了不能太用力開",
      "focusChar": "力",
      "displayLines": [
        "這門快壞了，",
        "不能太用力開。"
      ],
      "imageNotes": "家門或室內門快壞了，主角媽媽提醒主角小女孩不要太用力開門。門可以看起來有點鬆動或舊，但不要危險倒塌。人物身份要明確：主角媽媽、主角小女孩。不可有門牌、文字、數字或標籤。"
    }
  ],

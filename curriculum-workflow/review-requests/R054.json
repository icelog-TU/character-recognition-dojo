  "approvedSentences": [
    {
      "id": "R054-S01",
      "text": "全班分組，在教室外玩球。",
      "spokenText": "全班分組在教室外玩球",
      "displayLines": [
        "全班分組，",
        "在教室外",
        "玩球。"
      ],
      "focusChar": "組",
      "zhuyinOverrides": {
        "5": "ㄐㄧㄠˋ"
      },
      "imageNotes": "學校教室外的寬敞活動空間，班上同學分成幾個小組，各組使用自己的軟球玩傳接球。主角女孩在其中一組，其他孩子使用不同外貌的 generic 同學，固定老師在旁照看。教室外牆與門窗可在背景辨識；一定在戶外活動區，不在教室內，也不在狹窄走廊玩球。"
    },
    {
      "id": "R054-S02",
      "text": "各隊同意輪流用球場。",
      "spokenText": "各隊同意輪流用球場",
      "displayLines": [
        "各隊同意",
        "輪流用球場。"
      ],
      "focusChar": "輪",
      "imageNotes": "學校球場邊，兩支穿不同顏色球衣的 generic 學生隊伍正在交接使用球場。一隊帶球走向場內，另一隊拿著球在場外休息等候，兩位帶隊老師以友善手勢確認輪替。呈現大家同意依序使用，不是兩隊正在對打，也不是被趕出球場。無文字時刻表。"
    },
    {
      "id": "R054-S03",
      "text": "主人想辦法找回不見的小狗。",
      "spokenText": "主人想辦法找回不見的小狗",
      "displayLines": [
        "主人想辦法",
        "找回不見的",
        "小狗。"
      ],
      "focusChar": "辦",
      "imageNotes": "社區街角，一位 generic 成年飼主拿著小狗照片詢問另一位 generic 鄰居，另一手拿空牽繩，神情擔心但冷靜。照片上只有小狗圖像，不帶文字。失蹤小狗不出現在現實場景中，避免變成已經找到；可見的狗只在照片裡。飼主須明顯不同於固定媽媽：短捲灰髮、較深暖膚色、深綠外套、鏽橘上衣、炭灰長褲與酒紅斜背包；不得使用白／米色上衣、藍色長褲、長直深髮或棕色大肩包。不是主角爸爸或媽媽的固定家犬設定。"
    },
    {
      "id": "R054-S04",
      "text": "大家幫助生病的小孩完成心願。",
